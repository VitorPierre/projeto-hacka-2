<div class="w-full max-w-md mx-auto mt-0 md:mt-4 bg-white p-6 md:p-8 rounded-[1.5rem] shadow-sm border border-aprende-secondary">
  <h1 class="text-2xl font-medium text-aprende-text mb-6 text-center">Criar sua conta</h1>

  <%= form_with model: @user, local: true, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div role="alert" class="bg-red-50 border border-red-200 text-red-800 rounded-xl p-4 mb-4 text-sm font-medium">
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          <span>Ops! Por favor, corrija os <%= @user.errors.count %> erro(s) abaixo para prosseguir:</span>
        </div>
      </div>
    <% end %>

    <div>
      <%= f.label :role, "O que você deseja ser?", for: "role_select", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.select :role, [["Quero Aprender (Aluno)", "student"], ["Quero Ensinar (Professor)", "teacher"]], { selected: @role }, id: "role_select", class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 bg-white text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary", aria: @user.errors[:role].any? ? { describedby: "user_role_error" } : {} %>
      <%= field_error(@user, :role) %>
    </div>

    <div>
      <%= f.label :name, "Nome Completo", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.text_field :name, data: { moderation_check: true }, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary", aria: @user.errors[:name].any? ? { describedby: "user_name_error" } : {} %>
      <%= field_error(@user, :name) %>
    </div>

    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.email_field :email, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary", aria: @user.errors[:email].any? ? { describedby: "user_email_error" } : {} %>
      <%= field_error(@user, :email) %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :cpf, "CPF", class: "block text-sm font-medium text-aprende-text mb-1" %>
        <%= f.text_field :cpf, data: { controller: "mask", mask_type_value: "cpf" }, placeholder: "000.000.000-00", class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary", aria: @user.errors[:cpf].any? ? { describedby: "user_cpf_error" } : {} %>
        <%= field_error(@user, :cpf) %>
      </div>

      <div>
        <%= f.label :phone, "Telefone", class: "block text-sm font-medium text-aprende-text mb-1" %>
        <%= f.text_field :phone, data: { controller: "mask", mask_type_value: "phone" }, placeholder: "(00) 00000-0000", class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary", aria: @user.errors[:phone].any? ? { describedby: "user_phone_error" } : {} %>
        <%= field_error(@user, :phone) %>
      </div>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.password_field :password, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary", aria: @user.errors[:password].any? ? { describedby: "user_password_error" } : {} %>
      <%= field_error(@user, :password) %>
    </div>

    <div id="teacher_fields" class="<%= @role == 'teacher' ? '' : 'hidden' %> space-y-4 border-t border-aprende-secondary mt-6 pt-4">
      <h2 class="text-sm font-medium text-aprende-text mb-2">Informações do Professor</h2>
      
      <div>
        <%= f.label :education_level, "Escolaridade", class: "block text-sm font-medium text-aprende-text mb-1" %>
        <%= f.select :education_level, User::EDUCATION_LEVEL_NAMES.invert.to_a, {}, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 bg-white text-aprende-text", aria: @user.errors[:education_level].any? ? { describedby: "user_education_level_error" } : {} %>
        <%= field_error(@user, :education_level) %>
      </div>

      <div>
        <%= f.label :certificate_url, "URL do Certificado (PDF/Drive)", class: "block text-sm font-medium text-aprende-text mb-1" %>
        <%= f.url_field :certificate_url, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary", aria: @user.errors[:certificate_url].any? ? { describedby: "user_certificate_url_error" } : {} %>
        <%= field_error(@user, :certificate_url) %>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-aprende-text mb-1">Áreas de Ensino</label>
        <div class="space-y-2">
          <% if Subject.any? %>
            <%= f.collection_check_boxes :subject_ids, Subject.all, :id, :name do |b| %>
              <div class="flex items-center">
                <%= b.check_box class: "h-4 w-4 text-aprende-primary focus:ring-aprende-primary border-aprende-secondary rounded bg-white" %>
                <%= b.label class: "ml-2 block text-sm text-aprende-text" %>
              </div>
            <% end %>
            <%= field_error(@user, :subject_ids) %>
          <% else %>
            <p class="text-sm text-aprende-muted italic">Nenhuma área cadastrada no sistema. Contate o suporte.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div id="student_fields" class="<%= @role == 'student' ? '' : 'hidden' %> space-y-4 border-t border-aprende-secondary mt-6 pt-4">
      <h2 class="text-sm font-medium text-aprende-text mb-2">Informações do Aluno</h2>
      <div>
        <label for="student_subject" class="block text-sm font-medium text-aprende-text mb-1">Área de Interesse Principal</label>
        <% if Subject.any? %>
          <%= f.collection_select :subject_ids, Subject.all, :id, :name, { prompt: "Selecione..." }, { name: "user[subject_ids][]", id: "student_subject", class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 bg-white text-aprende-text" } %>
          <%= field_error(@user, :subject_ids) %>
        <% else %>
          <p class="text-sm text-aprende-muted italic">Nenhuma área cadastrada no sistema. Contate o suporte.</p>
        <% end %>
      </div>
    </div>

    <div class="pt-4">
      <%= f.submit "Finalizar Cadastro", class: "w-full bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 px-4 rounded-xl transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

<script>
  function toggleRoleFields() {
    const roleSelect = document.getElementById('role_select');
    if (!roleSelect) return;
    
    if (roleSelect.value === 'teacher') {
      document.getElementById('teacher_fields').classList.remove('hidden');
      document.getElementById('student_fields').classList.add('hidden');
    } else {
      document.getElementById('teacher_fields').classList.add('hidden');
      document.getElementById('student_fields').classList.remove('hidden');
    }
  }

  // Bind para a carga inicial e navegação via Turbo
  document.addEventListener('turbo:load', function() {
    const roleSelect = document.getElementById('role_select');
    if (roleSelect) {
      roleSelect.addEventListener('change', toggleRoleFields);
      toggleRoleFields();
    }
  });

  // Fallback caso Turbo não esteja disparando na primeira carga
  document.addEventListener('DOMContentLoaded', function() {
    const roleSelect = document.getElementById('role_select');
    if (roleSelect) {
      roleSelect.addEventListener('change', toggleRoleFields);
      toggleRoleFields();
    }
  });
</script>
