<div class="w-full max-w-md mx-auto mt-0 md:mt-4 bg-white p-6 md:p-8 rounded-[1.5rem] shadow-sm border border-aprende-secondary">
  <h2 class="text-2xl font-medium text-aprende-text mb-6 text-center">Criar sua conta</h2>

  <%= form_with model: @user, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :role, "O que você deseja ser?", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.select :role, [["Quero Aprender (Aluno)", "student"], ["Quero Ensinar (Professor)", "teacher"]], { selected: @role }, id: "role_select", class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 bg-white text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary" %>
    </div>

    <div>
      <%= f.label :name, "Nome Completo", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.text_field :name, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary" %>
    </div>

    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.email_field :email, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.password_field :password, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary" %>
    </div>

    <div id="teacher_fields" class="<%= @role == 'teacher' ? '' : 'hidden' %> space-y-4 border-t border-aprende-secondary mt-6 pt-4">
      <h3 class="text-sm font-medium text-aprende-text mb-2">Informações do Professor</h3>
      
      <div>
        <%= f.label :education_level, "Escolaridade", class: "block text-sm font-medium text-aprende-text mb-1" %>
        <%= f.select :education_level, User.education_levels.keys.map { |w| [w.humanize, w] }, {}, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 bg-white text-aprende-text" %>
      </div>

      <div>
        <%= f.label :certificate_url, "URL do Certificado (PDF/Drive)", class: "block text-sm font-medium text-aprende-text mb-1" %>
        <%= f.url_field :certificate_url, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary" %>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-aprende-text mb-1">Áreas de Ensino</label>
        <div class="space-y-2">
          <% if Subject.any? %>
            <%= f.collection_check_boxes :subject_ids, Subject.all, :id, :name do |b| %>
              <div class="flex items-center">
                <%= b.check_box class: "h-4 w-4 text-aprende-primary focus:ring-aprende-primary border-aprende-secondary rounded bg-white" %>
                <%= b.label class: "ml-2 block text-sm text-aprende-text" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-aprende-muted italic">Nenhuma área cadastrada no sistema. Contate o suporte.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div id="student_fields" class="<%= @role == 'student' ? '' : 'hidden' %> space-y-4 border-t border-aprende-secondary mt-6 pt-4">
      <h3 class="text-sm font-medium text-aprende-text mb-2">Informações do Aluno</h3>
      <div>
        <label class="block text-sm font-medium text-aprende-text mb-1">Área de Interesse Principal</label>
        <% if Subject.any? %>
          <%= f.collection_select :subject_ids, Subject.all, :id, :name, { prompt: "Selecione..." }, { name: "user[subject_ids][]", id: "student_subject", class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 bg-white text-aprende-text" } %>
        <% else %>
          <p class="text-sm text-aprende-muted italic">Nenhuma área cadastrada no sistema. Contate o suporte.</p>
        <% end %>
      </div>
    </div>

    <div class="pt-4">
      <%= f.submit "Finalizar Cadastro", class: "w-full bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 px-4 rounded-xl transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>

<script>
  function toggleRoleFields() {
    const roleSelect = document.getElementById('role_select');
    if (!roleSelect) return;
    
    if (roleSelect.value === 'teacher') {
      document.getElementById('teacher_fields').classList.remove('hidden');
      document.getElementById('student_fields').classList.add('hidden');
    } else {
      document.getElementById('teacher_fields').classList.add('hidden');
      document.getElementById('student_fields').classList.remove('hidden');
    }
  }

  // Bind para a carga inicial e navegação via Turbo
  document.addEventListener('turbo:load', function() {
    const roleSelect = document.getElementById('role_select');
    if (roleSelect) {
      roleSelect.addEventListener('change', toggleRoleFields);
      toggleRoleFields();
    }
  });

  // Fallback caso Turbo não esteja disparando na primeira carga
  document.addEventListener('DOMContentLoaded', function() {
    const roleSelect = document.getElementById('role_select');
    if (roleSelect) {
      roleSelect.addEventListener('change', toggleRoleFields);
      toggleRoleFields();
    }
  });
</script>
