<div class="w-full max-w-md mx-auto mt-0 md:mt-4 bg-white p-6 md:p-8 rounded-[1.5rem] shadow-sm border border-aprende-secondary">
  <h1 class="text-2xl font-medium text-aprende-text mb-6 text-center">Acesse sua conta</h1>

  <%= form_with url: login_path, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.email_field :email, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 focus:outline-none focus:ring-2 focus:ring-aprende-primary focus:border-aprende-primary text-aprende-text placeholder-aprende-muted" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm font-medium text-aprende-text mb-1" %>
      <%= f.password_field :password, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 focus:outline-none focus:ring-2 focus:ring-aprende-primary focus:border-aprende-primary text-aprende-text placeholder-aprende-muted" %>
    </div>

    <div class="pt-2">
      <%= f.submit "Entrar na plataforma", class: "w-full bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 px-4 rounded-xl transition-colors cursor-pointer" %>
    </div>
  <% end %>



  <p class="mt-6 text-center text-sm text-aprende-muted">
    Ainda não tem conta? <%= link_to "Cadastre-se", new_user_path, class: "text-aprende-primary hover:underline font-medium" %>
  </p>
</div>
