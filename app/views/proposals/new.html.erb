<div class="max-w-2xl mx-auto w-full flex flex-col gap-6">
  <h1 class="text-2xl md:text-3xl font-medium text-aprende-text px-2">
    <% if @proposal.experimental_invite? %>
      Convidar para Aula Experimental
    <% elsif @proposal.doubt_clarification? %>
      Iniciar Esclarecimento de Dúvidas
    <% else %>
      Enviar Proposta de Aula
    <% end %>
  </h1>

  <div class="bg-white p-6 md:p-8 rounded-[1.5rem] shadow-sm border border-aprende-secondary flex flex-col gap-6">
    <% if current_user.teacher? %>
      <% counterpart = @student || User.new(name: "Estudante não encontrado") %>
      <% counterpart_label = "Estudante" %>
      <% counterpart_subjects = current_user.subjects || [] %>
    <% else %>
      <% counterpart = @teacher || User.new(name: "Professor não encontrado") %>
      <% counterpart_label = "Professor" %>
      <% counterpart_subjects = @teacher&.subjects || [] %>
    <% end %>

    <div class="pb-6 border-b border-aprende-secondary">
      <h2 class="font-medium text-aprende-muted text-sm uppercase tracking-wider mb-2">Detalhes do <%= counterpart_label %></h2>
      <p class="text-xl font-medium text-aprende-text"><%= counterpart.name %></p>
      <% if counterpart.teacher? %>
        <p class="text-aprende-primary font-medium mt-1">Escolaridade: <%= counterpart.education_level_human %></p>
      <% end %>
      
      <% if !current_user.teacher? && (@teacher&.technical? || @teacher&.higher?) %>
        <div class="mt-4 bg-aprende-bg border border-aprende-secondary text-aprende-text p-4 rounded-xl text-sm flex gap-3 items-start animate-fadeIn">
          <svg class="w-5 h-5 text-aprende-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <strong class="font-medium">Negociação Livre:</strong> O envio desta proposta é totalmente flexível e não há bloqueios por preço. A plataforma exibirá recomendações de valor baseadas no nível de formação do professor para orientar sua negociação.
          </div>
        </div>
      <% end %>
    </div>

    <%= form_with model: @proposal, class: "flex flex-col gap-6", id: "proposal-form", multipart: true do |f| %>
      <% if current_user.teacher? %>
        <%= f.hidden_field :student_id, value: @student&.id %>
      <% else %>
        <%= f.hidden_field :teacher_id, value: @teacher&.id %>
      <% end %>
      <%= f.hidden_field :proposal_type, value: @proposal.proposal_type %>
      
      <div class="flex flex-col gap-1">
        <%= f.label :subject_id, "Selecione a Especialidade", for: "proposal_subject_id", class: "text-sm font-medium text-aprende-text" %>
        <%= f.collection_select :subject_id, counterpart_subjects, :id, :name, { prompt: "Escolha uma especialidade..." }, id: "proposal_subject_id", class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 focus:outline-none focus:ring-2 focus:ring-aprende-primary bg-white text-aprende-text", aria: @proposal.errors[:subject_id].any? ? { describedby: "proposal_subject_id_error" } : {} %>
        <%= field_error(@proposal, :subject_id) %>
      </div>

      <% if @proposal.standard_proposal? %>
        <div class="flex flex-col gap-1">
          <%= f.label :modality, "Modalidade de Ensino", for: "modality-select", class: "text-sm font-medium text-aprende-text" %>
          <%= f.select :modality, [["Pílula de Conhecimento (Dúvida Assíncrona)", "knowledge_pill"], ["Mentoria Focada (Síncrono)", "focused_mentoring"]], {}, class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 focus:outline-none focus:ring-2 focus:ring-aprende-primary bg-white text-aprende-text", id: "modality-select", aria: @proposal.errors[:modality].any? ? { describedby: "proposal_modality_error" } : {} %>
          <%= field_error(@proposal, :modality) %>
        </div>
      <% else %>
        <%= f.hidden_field :modality, value: @proposal.modality, id: "modality-select" %>
        <div class="flex flex-col gap-1">
          <span class="text-sm font-medium text-aprende-text">Modalidade de Ensino</span>
          <div class="bg-gray-50 border border-aprende-secondary rounded-xl py-3 px-4 font-medium text-aprende-text">
            <%= @proposal.modality_human %>
          </div>
        </div>
      <% end %>

      <fieldset class="flex flex-col gap-1.5 hidden" id="duration-container">
        <legend class="text-sm font-medium text-aprende-text">Duração da Mentoria</legend>
        <div class="flex gap-4">
          <div class="flex-1 flex flex-col gap-1">
            <label for="duration-hours" class="text-xs text-aprende-muted">Horas</label>
            <select id="duration-hours" class="w-full border border-aprende-secondary rounded-xl py-2.5 px-3 focus:outline-none focus:ring-2 focus:ring-aprende-primary bg-white text-aprende-text">
              <option value="0">0h</option>
              <option value="1" selected>1h</option>
              <option value="2">2h</option>
              <option value="3">3h</option>
              <option value="4">4h</option>
              <option value="5">5h</option>
            </select>
          </div>
          <div class="flex-1 flex flex-col gap-1">
            <label for="duration-minutes" class="text-xs text-aprende-muted">Minutos</label>
            <select id="duration-minutes" class="w-full border border-aprende-secondary rounded-xl py-2.5 px-3 focus:outline-none focus:ring-2 focus:ring-aprende-primary bg-white text-aprende-text">
              <option value="0" selected>0 min</option>
              <option value="15">15 min</option>
              <option value="30">30 min</option>
              <option value="45">45 min</option>
            </select>
          </div>
        </div>
        <%= f.hidden_field :duration, id: "duration-input" %>
        <%= field_error(@proposal, :duration) %>
      </fieldset>

      <div class="flex flex-col gap-1">
        <div class="flex justify-between items-end">
          <%= f.label :price, "Valor da Proposta (R$)", for: "price-input", class: "text-sm font-medium text-aprende-text" %>
          <span id="price-hint" class="text-xs text-aprende-muted"></span>
        </div>
        <% initial_price = current_user.teacher? ? "0,00" : (((@teacher&.technical? || @teacher&.higher?) ? "50,00" : "")) %>
        <%= f.text_field :price, value: initial_price, data: { controller: "mask", mask_type_value: "money" }, placeholder: "R$ 0,00", class: "w-full border border-aprende-secondary rounded-xl py-2.5 px-3 focus:outline-none focus:ring-2 focus:ring-aprende-primary bg-white text-aprende-text text-lg placeholder-aprende-muted", id: "price-input", aria: @proposal.errors[:price].any? ? { describedby: "proposal_price_error" } : {} %>
        <%= field_error(@proposal, :price) %>

        <div id="price-recommendation-box" class="hidden p-4 rounded-xl text-sm flex gap-3 items-start border mt-2 transition-all duration-300">
          <div id="price-recommendation-icon" class="flex-shrink-0 mt-0.5"></div>
          <div id="price-recommendation-text" class="font-medium"></div>
        </div>
      </div>

      <div id="free-trial-container" class="hidden flex items-center gap-2">
        <input type="checkbox" id="free-trial-checkbox" class="w-4 h-4 text-aprende-primary bg-white border-aprende-secondary rounded focus:ring-aprende-primary focus:ring-2 cursor-pointer">
        <label for="free-trial-checkbox" class="text-sm font-medium text-aprende-text cursor-pointer select-none">Quero tentar gratuitamente</label>
      </div>

      <div id="knowledge-pill-message-container" class="hidden flex flex-col gap-3 p-4 bg-aprende-bg rounded-xl border border-aprende-secondary mt-2">
        <% if current_user.teacher? %>
          <%= label_tag :message_content, "Descrição / Mensagem Inicial", for: "message-content-input", class: "text-sm font-medium text-aprende-text" %>
          <p class="text-xs text-aprende-muted">Escreva uma mensagem explicando como você pode ajudar o aluno ou dê orientações iniciais.</p>
          <%= text_area_tag :message_content, "", rows: 4, placeholder: "Ex: Olá! Posso te ajudar a resolver sua dúvida...", id: "message-content-input", class: "w-full p-3 rounded-lg border border-aprende-secondary bg-white text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary resize-none" %>
        <% else %>
          <%= label_tag :message_content, "Sua Dúvida / Pergunta", for: "message-content-input", class: "text-sm font-medium text-aprende-text" %>
          <p class="text-xs text-aprende-muted">Descreva sua dúvida com clareza. Você também pode anexar um arquivo.</p>
          <%= text_area_tag :message_content, "", rows: 4, placeholder: "Escreva sua dúvida detalhadamente aqui...", id: "message-content-input", class: "w-full p-3 rounded-lg border border-aprende-secondary bg-white text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary resize-none" %>
        <% end %>
        
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2">
            <label for="attachment-input" class="cursor-pointer bg-white border border-aprende-secondary hover:bg-gray-50 text-aprende-text py-2 px-4 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
              <svg class="w-4 h-4 text-aprende-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
              Anexar Arquivo
              <%= file_field_tag :attachment, id: "attachment-input", class: "sr-only", multiple: true %>
            </label>
          </div>
          <div id="attachment-preview" class="hidden flex flex-col gap-1.5 mt-1"></div>
        </div>
      </div>

      <div class="bg-aprende-bg border border-aprende-secondary rounded-xl p-4 flex flex-col gap-2 text-sm text-aprende-muted">
        <p class="font-medium text-aprende-text">Resumo da Monetização</p>
        <div class="flex justify-between">
          <span>Taxa da Plataforma (20%):</span>
          <span id="platform-fee">R$ 0,00</span>
        </div>
        <div class="flex justify-between font-medium text-aprende-text pt-2 border-t border-aprende-secondary/50">
          <span>Professor Receberá:</span>
          <span id="teacher-receives" class="text-aprende-primary">R$ 0,00</span>
        </div>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row gap-4">
        <% cancel_path = current_user.teacher? ? student_path(counterpart) : teachers_path %>
        <%= link_to "Cancelar", cancel_path, class: "w-full sm:flex-1 text-center bg-white border border-aprende-secondary hover:bg-aprende-bg text-aprende-muted font-medium py-3 rounded-xl transition-colors" %>
        <%= f.submit (@proposal.experimental_invite? ? "Enviar Convite" : (@proposal.doubt_clarification? ? "Iniciar Esclarecimento" : "Enviar Proposta")), class: "w-full sm:flex-1 bg-aprende-primary hover:bg-aprende-primary-hover text-white font-medium py-3 rounded-xl transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function() {
    function initializeProposalForm() {
      const modalitySelect = document.getElementById("modality-select");
      if (!modalitySelect || modalitySelect.dataset.proposalFormAttached) return;
      modalitySelect.dataset.proposalFormAttached = "true";

      const durationContainer = document.getElementById("duration-container");
      const durationInput = document.getElementById("duration-input");
      const durationHoursSelect = document.getElementById("duration-hours");
      const durationMinutesSelect = document.getElementById("duration-minutes");
      const priceInput = document.getElementById("price-input");
      const priceHint = document.getElementById("price-hint");
      const platformFeeEl = document.getElementById("platform-fee");
      const teacherReceivesEl = document.getElementById("teacher-receives");
      const freeTrialContainer = document.getElementById("free-trial-container");
      const freeTrialCheckbox = document.getElementById("free-trial-checkbox");
      const knowledgePillMessageContainer = document.getElementById("knowledge-pill-message-container");

      const isCertifiedTeacher = <%= (!current_user.teacher? && (@teacher&.technical? || @teacher&.higher?)) ? "true" : "false" %>;
      const priceRecommendationBox = document.getElementById("price-recommendation-box");
      const priceRecommendationIcon = document.getElementById("price-recommendation-icon");
      const priceRecommendationText = document.getElementById("price-recommendation-text");

      function updateForm() {
        const modality = modalitySelect.value;
        
        const isTeacher = <%= current_user.teacher? ? "true" : "false" %>;
        if (modality === "knowledge_pill") {
          if (durationContainer) durationContainer.classList.add("hidden");
          if (freeTrialContainer) {
            if (isTeacher) {
              freeTrialContainer.classList.add("hidden");
            } else {
              freeTrialContainer.classList.remove("hidden");
            }
          }
          if (knowledgePillMessageContainer) knowledgePillMessageContainer.classList.remove("hidden");
          if (priceHint) priceHint.textContent = isTeacher ? "Valor do atendimento (pode ser R$ 0,00)" : "Bounty: Defina sua recompensa pela dúvida";
        } else {
          if (durationContainer) durationContainer.classList.add("hidden");
          if (freeTrialContainer) freeTrialContainer.classList.add("hidden");
          if (knowledgePillMessageContainer) knowledgePillMessageContainer.classList.add("hidden");
          if (freeTrialCheckbox && freeTrialCheckbox.checked) {
            freeTrialCheckbox.checked = false;
            restorePrice();
          }
          
          if (modality === "focused_mentoring") {
            if (durationContainer) durationContainer.classList.remove("hidden");
            
            let totalMins = parseInt(durationInput.value);
            if (isNaN(totalMins) || totalMins <= 0) {
              totalMins = 60; // default to 60 minutes
            }
            durationInput.value = totalMins;
            
            const hours = Math.floor(totalMins / 60);
            const minutes = totalMins % 60;
            if (durationHoursSelect) durationHoursSelect.value = hours;
            if (durationMinutesSelect) durationMinutesSelect.value = minutes;

            if (priceHint) priceHint.textContent = isTeacher ? "Valor do convite (pode ser R$ 0,00)" : "Mentoria Focada: Negociação da aula (sugerido R$ 50/h)";
          }
        }

        calculateFees();
      }

      function updateHiddenDuration() {
        if (!durationHoursSelect || !durationMinutesSelect || !durationInput) return;
        const hours = parseInt(durationHoursSelect.value) || 0;
        const minutes = parseInt(durationMinutesSelect.value) || 0;
        const totalMinutes = (hours * 60) + minutes;
        
        durationInput.value = totalMinutes;
        calculateFees();
      }

      function toggleFreeTrial() {
        if (freeTrialCheckbox && freeTrialCheckbox.checked) {
          if (priceInput) {
            priceInput.dataset.previousValue = priceInput.value;
            priceInput.value = "0,00";
            priceInput.readOnly = true;
            priceInput.classList.add("opacity-50", "bg-gray-100");
          }
        } else {
          restorePrice();
        }
        calculateFees();
      }
      
      function restorePrice() {
        if (priceInput) {
          priceInput.value = priceInput.dataset.previousValue || "";
          priceInput.readOnly = false;
          priceInput.classList.remove("opacity-50", "bg-gray-100");
        }
      }

      function updatePriceRecommendation() {
        if (!isCertifiedTeacher || !priceRecommendationBox || !priceInput) return;

        const modality = modalitySelect.value;
        let rawVal = priceInput.value.replace("R$ ", "").replace(/\./g, "").replace(",", ".");
        let val = parseFloat(rawVal);
        if (isNaN(val)) val = 0.0;

        let recommendedPrice = 15.0;
        let labelDetail = "";

        if (modality === "knowledge_pill") {
          recommendedPrice = 15.0;
          labelDetail = "R$ 15,00 por pílula";
        } else if (modality === "focused_mentoring") {
          const totalMinutes = durationInput ? (parseInt(durationInput.value) || 60) : 60;
          recommendedPrice = (50.0 / 60.0) * totalMinutes;
          
          let durationText = "";
          const h = Math.floor(totalMinutes / 60);
          const m = totalMinutes % 60;
          if (h > 0) {
            durationText += `${h} ${h === 1 ? 'hora' : 'horas'}`;
          }
          if (m > 0) {
            if (durationText) durationText += " e ";
            durationText += `${m} ${m === 1 ? 'minuto' : 'minutos'}`;
          }
          
          labelDetail = `R$ 50,00 por hora (Duração: ${durationText} - Total recomendado: R$ ${recommendedPrice.toFixed(2).replace(".", ",")})`;
        }

        priceRecommendationBox.classList.remove("hidden");

        if (val < recommendedPrice) {
          priceRecommendationBox.className = "p-4 rounded-xl text-sm flex gap-3 items-start border mt-2 bg-amber-50 text-amber-800 border-amber-200 animate-fadeIn transition-all duration-300";
          if (priceRecommendationIcon) {
            priceRecommendationIcon.innerHTML = `
              <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            `;
          }
          if (priceRecommendationText) {
            priceRecommendationText.innerHTML = `Valor recomendado para este professor: <strong>R$ ${recommendedPrice.toFixed(2).replace(".", ",")}</strong> (${labelDetail}). O seu valor proposto está abaixo do recomendado, mas você é livre para negociar e enviar a proposta!`;
          }
        } else {
          priceRecommendationBox.className = "p-4 rounded-xl text-sm flex gap-3 items-start border mt-2 bg-aprende-bg text-aprende-text border-aprende-secondary animate-fadeIn transition-all duration-300";
          if (priceRecommendationIcon) {
            priceRecommendationIcon.innerHTML = `
              <svg class="w-5 h-5 text-aprende-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            `;
          }
          if (priceRecommendationText) {
            priceRecommendationText.innerHTML = `Valor recomendado para este professor: <strong>R$ ${recommendedPrice.toFixed(2).replace(".", ",")}</strong> (${labelDetail}). Seu valor proposto está de acordo com a recomendação da plataforma!`;
          }
        }
      }

      function calculateFees() {
        if (!priceInput || !platformFeeEl || !teacherReceivesEl) return;
        let rawVal = priceInput.value.replace("R$ ", "").replace(/\./g, "").replace(",", ".");
        let val = parseFloat(rawVal);
        if (isNaN(val) || val <= 0) {
          platformFeeEl.textContent = "R$ 0,00";
          teacherReceivesEl.textContent = "R$ 0,00";
          updatePriceRecommendation();
          return;
        }
        
        let fee = val * 0.20;
        let net = val - fee;
        
        platformFeeEl.textContent = fee.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        teacherReceivesEl.textContent = net.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        updatePriceRecommendation();
      }

      modalitySelect.addEventListener("change", updateForm);
      if (durationHoursSelect) {
        durationHoursSelect.addEventListener("change", updateHiddenDuration);
      }
      if (durationMinutesSelect) {
        durationMinutesSelect.addEventListener("change", updateHiddenDuration);
      }
      if (priceInput) {
        priceInput.addEventListener("input", calculateFees);
      }
      if (freeTrialCheckbox) {
        freeTrialCheckbox.addEventListener("change", toggleFreeTrial);
      }

      const attachmentInput = document.getElementById("attachment-input");
      const attachmentPreview = document.getElementById("attachment-preview");

      if (attachmentInput && attachmentPreview) {
        attachmentInput.addEventListener("change", function() {
          attachmentPreview.innerHTML = "";
          const files = attachmentInput.files;
          if (files && files.length > 0) {
            attachmentPreview.classList.remove("hidden");
            
            if (files.length === 1) {
              const file = files[0];
              const sizeKB = (file.size / 1024).toFixed(1);
              attachmentPreview.innerHTML = `
                <div class="flex items-center gap-2 text-xs font-semibold text-aprende-primary bg-aprende-bg border border-aprende-primary/30 p-2.5 rounded-lg animate-fadeIn">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  <span class="truncate font-medium">${file.name}</span>
                  <span class="text-[10px] text-aprende-muted flex-shrink-0">(${sizeKB} KB)</span>
                </div>
              `;
            } else {
              let listHTML = `
                <div class="bg-amber-50 border border-amber-200 text-amber-900 p-3.5 rounded-xl text-xs flex flex-col gap-2 shadow-sm animate-fadeIn">
                  <div class="flex items-center gap-2 font-bold text-amber-800">
                    <svg class="w-4 h-4 text-amber-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    <span>${files.length} arquivos selecionados:</span>
                  </div>
                  <ul class="list-disc list-inside pl-1 flex flex-col gap-1 font-medium text-amber-800/80">
              `;
              
              for (let i = 0; i < files.length; i++) {
                listHTML += `<li class="truncate">${files[i].name}</li>`;
              }
              
              listHTML += `
                  </ul>
                  <div class="pt-2 border-t border-amber-200/50 text-[10px] text-amber-700 font-semibold">
                    Nota: Apenas o primeiro anexo listado será enviado na proposta.
                  </div>
                </div>
              `;
              attachmentPreview.innerHTML = listHTML;
            }
          } else {
            attachmentPreview.classList.add("hidden");
          }
        });
      }
      
      // Initial run
      updateForm();
    }

    // Bind to both load and render to catch validation error re-renders
    document.addEventListener("turbo:load", initializeProposalForm);
    document.addEventListener("turbo:render", initializeProposalForm);
    
    // Also invoke immediately to handle direct page loads
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeProposalForm);
    } else {
      initializeProposalForm();
    }
  })();
</script>
