<div class="max-w-4xl mx-auto w-full flex flex-col gap-6">
  <!-- Detalhes da Proposta -->
  <div class="bg-white rounded-[1.5rem] shadow-sm border border-aprende-secondary p-6 md:p-8 flex flex-col gap-6">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 border-b border-aprende-secondary pb-6">
      <div>
        <h1 class="text-2xl md:text-3xl font-medium text-aprende-text">Proposta: <%= @proposal.subject.name %></h1>
        <div class="flex flex-col gap-2 mt-4 text-aprende-muted">
          <p><strong class="font-medium">Aluno:</strong> <%= @proposal.student.name %></p>
          <p><strong class="font-medium">Professor:</strong> <%= @proposal.teacher.name %></p>
          <p><strong class="font-medium">Valor:</strong> <%= number_to_currency(@proposal.price) %></p>
        </div>
      </div>
      
      <div class="flex flex-col items-end gap-3">
        <span class="inline-block px-4 py-2 text-sm font-medium rounded-full <%= @proposal.status == 'pending' ? 'bg-yellow-50 text-yellow-700 border border-yellow-200' : (@proposal.status == 'accepted' ? 'bg-aprende-bg text-aprende-primary border border-aprende-primary' : 'bg-gray-100 text-gray-600 border border-gray-200') %>">
          Status: <%= @proposal.status.humanize %>
        </span>
      </div>
    </div>

    <!-- Ações -->
    <div class="flex flex-wrap gap-4">
      <% if current_user.teacher? && @proposal.pending? %>
        <%= button_to "Aceitar Proposta", accept_proposal_path(@proposal), method: :patch, class: "bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-2.5 px-6 rounded-xl transition-colors cursor-pointer" %>
        <%= button_to "Recusar", reject_proposal_path(@proposal), method: :patch, class: "bg-white text-red-600 border border-red-200 hover:bg-red-50 font-medium py-2.5 px-6 rounded-xl transition-colors cursor-pointer", form: { data: { turbo_confirm: 'Tem certeza que deseja recusar?' } } %>
      <% end %>

      <% if @proposal.accepted? %>
        <%= button_to "Fechar Proposta", close_proposal_path(@proposal), method: :patch, class: "bg-white text-aprende-text border border-aprende-secondary hover:bg-gray-50 font-medium py-2.5 px-6 rounded-xl transition-colors cursor-pointer", form: { data: { turbo_confirm: 'Tem certeza que deseja fechar a proposta?' } } %>
      <% end %>
      
      <%= link_to "Voltar", current_user.student? ? student_path(current_user) : teacher_path(current_user), class: "text-aprende-muted hover:text-aprende-text py-2.5 px-4 font-medium transition-colors" %>
    </div>
  </div>

  <!-- Chat / Mensagens -->
  <div class="bg-white rounded-[1.5rem] shadow-sm border border-aprende-secondary p-6 md:p-8 flex flex-col gap-6">
    <h2 class="text-xl font-medium text-aprende-text">Mensagens</h2>
    
    <div class="flex flex-col gap-4 max-h-[400px] overflow-y-auto pr-2">
      <% if @messages.any? %>
        <% @messages.each do |message| %>
          <div class="flex flex-col <%= message.user == current_user ? 'items-end' : 'items-start' %>">
            <span class="text-xs text-aprende-muted mb-1 px-1"><%= message.user.name %> - <%= message.created_at.strftime('%d/%m %H:%M') %></span>
            <div class="px-4 py-3 rounded-2xl max-w-[80%] <%= message.user == current_user ? 'bg-aprende-primary text-white rounded-tr-none' : 'bg-aprende-bg text-aprende-text border border-aprende-secondary rounded-tl-none' %>">
              <%= simple_format(message.content, class: "m-0") %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-aprende-muted text-center py-8">Nenhuma mensagem ainda. Envie a primeira mensagem!</p>
      <% end %>
    </div>

    <% if %w[pending accepted].include?(@proposal.status) %>
      <div class="border-t border-aprende-secondary pt-6 mt-2">
        <%= form_with model: [@proposal, @message], class: "flex flex-col gap-3" do |f| %>
          <%= f.text_area :content, placeholder: "Escreva sua mensagem...", rows: 3, class: "w-full p-4 rounded-xl border border-aprende-secondary bg-aprende-bg text-aprende-text placeholder-aprende-muted focus:outline-none focus:ring-2 focus:ring-aprende-primary transition-all resize-none", required: true %>
          <div class="flex justify-end">
            <%= f.submit "Enviar Mensagem", class: "bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-2.5 px-6 rounded-xl transition-colors cursor-pointer shadow-sm" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center mt-2">
        <p class="text-aprende-muted text-sm font-medium">Esta proposta está fechada ou foi recusada. O chat não está mais disponível para envio de mensagens.</p>
      </div>
    <% end %>
  </div>
</div>
