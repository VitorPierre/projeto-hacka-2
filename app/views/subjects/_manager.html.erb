<div class="flex items-center gap-2 w-full md:w-auto relative">
  <!-- Filter Form (Contains select box) -->
  <div class="w-full md:w-72 relative">
    <%= form_with url: url, method: :get, local: true, class: "group" do |f| %>
      <div class="relative flex items-center">
        <div class="absolute left-4 text-aprende-muted group-focus-within:text-aprende-primary transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
        </div>
        <%= f.select :subject_id, Subject.all.order(:name).map { |s| [s.name, s.id] }, { include_blank: blank_label, selected: params[:subject_id] }, { onchange: "this.form.submit()", class: "w-full pl-11 pr-4 py-3 bg-white border border-aprende-secondary rounded-full text-sm text-aprende-text focus:outline-none focus:ring-4 focus:ring-aprende-primary/10 focus:border-aprende-primary appearance-none transition-all shadow-sm cursor-pointer hover:border-aprende-primary/50" } %>
        <div class="absolute right-4 pointer-events-none text-aprende-muted">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Manage Button (Outside the filter form) -->
  <button type="button" onclick="toggleSpecialtyManager()" class="flex-shrink-0 bg-aprende-primary hover:bg-[#159b3f] text-white p-3 rounded-full hover:scale-105 transition-all shadow-sm focus:outline-none focus:ring-4 focus:ring-aprende-primary/10 flex items-center justify-center cursor-pointer" title="Gerenciar Especialidades">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
  </button>

  <!-- Specialty Manager Panel (Outside the filter form to avoid form nesting) -->
  <div id="specialty-manager-panel" class="hidden absolute right-0 md:right-0 top-full mt-3 w-80 bg-white border border-aprende-secondary rounded-[1.5rem] p-4 shadow-lg z-50 transition-all">
    <div class="flex items-center justify-between mb-3 border-b border-aprende-secondary pb-2">
      <h4 class="text-sm font-semibold text-aprende-text">Gerenciar Especialidades</h4>
      <button type="button" onclick="toggleSpecialtyManager()" class="text-aprende-muted hover:text-aprende-text">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Adicionar Nova Especialidade Form -->
    <%= form_with model: Subject.new, url: subjects_path, local: true, class: "mb-4" do |sf| %>
      <%= hidden_field_tag :redirect_to, request.original_fullpath %>
      <div class="flex gap-1.5">
        <%= sf.text_field :name, required: true, placeholder: "Nova especialidade...", class: "flex-1 border border-aprende-secondary rounded-xl py-1.5 px-3 focus:outline-none focus:ring-2 focus:ring-aprende-primary bg-white text-aprende-text text-xs" %>
        <%= sf.submit "Adicionar", class: "bg-aprende-primary hover:bg-[#159b3f] text-white font-medium px-3 py-1.5 rounded-xl text-xs transition-colors cursor-pointer" %>
      </div>
    <% end %>

    <!-- Lista Scrollable de Especialidades -->
    <div class="max-h-60 overflow-y-auto divide-y divide-aprende-secondary pr-1">
      <% if Subject.any? %>
        <% Subject.all.order(:name).each do |subject| %>
          <div class="py-2.5 flex items-center justify-between gap-2" id="subject-row-<%= subject.id %>">
            
            <!-- View Mode -->
            <div class="flex-1 min-w-0" id="subject-view-<%= subject.id %>">
              <p class="text-xs text-aprende-text truncate font-medium"><%= subject.name %></p>
            </div>

            <!-- Edit Mode Form (Hidden by default) -->
            <div class="hidden flex-1" id="subject-edit-<%= subject.id %>">
              <%= form_with model: subject, url: subject_path(subject), method: :patch, local: true, class: "flex gap-1" do |ef| %>
                <%= hidden_field_tag :redirect_to, request.original_fullpath %>
                <%= ef.text_field :name, required: true, class: "w-full border border-aprende-secondary rounded-lg py-1 px-2 bg-white text-aprende-text text-[11px] focus:outline-none focus:ring-1 focus:ring-aprende-primary" %>
                <button type="submit" class="bg-aprende-primary text-white p-1 rounded hover:bg-[#159b3f] flex items-center justify-center cursor-pointer" title="Salvar">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </button>
                <button type="button" onclick="cancelEdit(<%= subject.id %>)" class="bg-slate-100 text-slate-500 p-1 rounded hover:bg-slate-200 flex items-center justify-center cursor-pointer" title="Cancelar">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
              <% end %>
            </div>

            <!-- Actions (Pencil & Trash) -->
            <div class="flex items-center gap-1 flex-shrink-0" id="subject-actions-<%= subject.id %>">
              <button type="button" onclick="startEdit(<%= subject.id %>)" class="text-aprende-muted hover:text-aprende-primary p-1 rounded hover:bg-aprende-bg cursor-pointer" title="Editar">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
              </button>
              <%= button_to subject_path(subject), method: :delete, params: { redirect_to: request.original_fullpath }, data: { confirm: "Tem certeza que deseja remover esta especialidade? Isso desvinculará usuários e propostas associados." }, class: "text-red-500 hover:text-red-700 p-1 rounded hover:bg-red-50 flex items-center justify-center cursor-pointer", title: "Remover" do %>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              <% end %>
            </div>

          </div>
        <% end %>
      <% else %>
        <p class="text-xs text-aprende-muted py-3 text-center">Nenhuma especialidade disponível.</p>
      <% end %>
    </div>
  </div>
</div>

<script>
  function toggleSpecialtyManager() {
    const panel = document.getElementById('specialty-manager-panel');
    if (panel) {
      panel.classList.toggle('hidden');
    }
  }

  function startEdit(id) {
    document.getElementById('subject-view-' + id).classList.add('hidden');
    document.getElementById('subject-actions-' + id).classList.add('hidden');
    document.getElementById('subject-edit-' + id).classList.remove('hidden');
  }

  function cancelEdit(id) {
    document.getElementById('subject-view-' + id).classList.remove('hidden');
    document.getElementById('subject-actions-' + id).classList.remove('hidden');
    document.getElementById('subject-edit-' + id).classList.add('hidden');
  }

  // Close specialty manager if clicked outside
  document.addEventListener('click', function(event) {
    const panel = document.getElementById('specialty-manager-panel');
    const toggleBtn = event.target.closest('[onclick="toggleSpecialtyManager()"]');
    const isClickInside = panel && (panel.contains(event.target) || toggleBtn);
    
    if (panel && !isClickInside && !panel.classList.contains('hidden')) {
      panel.classList.add('hidden');
    }
  });
</script>
