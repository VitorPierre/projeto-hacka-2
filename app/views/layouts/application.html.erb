<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "aprendeAI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="aprendeAI">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="<%= asset_url('logo.png') %>" type="image/png">
    <link rel="icon" href="<%= asset_url('logo.png') %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_url('logo.png') %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-aprende-bg text-aprende-text font-sans min-h-screen flex flex-col">
    <nav class="bg-white/80 backdrop-blur-md border-b border-aprende-secondary px-4 md:px-8 py-4 flex justify-between items-center sticky top-0 z-50 transition-all">
      <div class="flex items-center gap-3">
        <!-- Hamburger Button (Mobile Only) -->
        <button type="button" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" class="md:hidden p-2 -ml-2 text-aprende-text hover:text-aprende-primary transition-colors cursor-pointer">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>

        <%= link_to root_path, class: "font-medium text-2xl tracking-tight hover:opacity-80 transition-opacity" do %>
          <span class="text-aprende-text">aprende</span><span class="text-aprende-primary font-bold">AI</span>
        <% end %>
      </div>
      
      <div class="flex items-center gap-6">
        <div class="hidden md:flex items-center gap-6">
          <% if !current_user || current_user.student? %>
            <%= link_to "Professores", teachers_path, class: "text-aprende-muted hover:text-aprende-primary font-medium transition-colors" %>
            <% if current_user&.student? %>
              <%= link_to "Aprender com IA", learn_path, class: "text-aprende-muted hover:text-aprende-primary font-medium transition-colors" %>
            <% end %>
          <% end %>
          <% if !current_user || current_user.teacher? %>
            <%= link_to "Alunos", students_path, class: "text-aprende-muted hover:text-aprende-primary font-medium transition-colors" %>
            <% if current_user&.teacher? %>
              <%= link_to "Planejar com IA", plan_path, class: "text-aprende-muted hover:text-aprende-primary font-medium transition-colors" %>
            <% end %>
          <% end %>
          <% if current_user&.admin? %>
            <%= link_to "Moderação", admin_moderation_index_path, class: "text-aprende-muted hover:text-aprende-primary font-medium transition-colors" %>
          <% end %>
        </div>
        
        <div class="hidden md:block w-px h-6 bg-aprende-secondary mx-2"></div>
        
        <% if current_user %>
          <div class="flex items-center gap-4">
            <!-- Notificações (Desktop) -->
            <div class="relative hidden md:block" data-controller="dropdown">
              <button type="button" onclick="document.getElementById('notif-dropdown').classList.toggle('hidden')" class="relative p-2 text-aprende-muted hover:text-aprende-primary transition-colors cursor-pointer">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                <% unread_count = current_user.notifications.unread.count %>
                <% if unread_count > 0 %>
                  <span class="absolute top-1 right-1 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full min-w-[1.25rem] text-center"><%= unread_count %></span>
                <% end %>
              </button>
              
              <div id="notif-dropdown" class="hidden absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-lg border border-aprende-secondary overflow-hidden z-50">
                <div class="px-4 py-3 border-b border-aprende-secondary bg-aprende-bg font-medium text-aprende-text text-sm">
                  Notificações
                </div>
                <div class="max-h-64 overflow-y-auto">
                  <% notifications = current_user.notifications.recent.limit(10) %>
                  <% if notifications.any? %>
                    <% notifications.each do |notification| %>
                      <%= button_to read_notification_path(notification), method: :patch, class: "block w-full text-left px-4 py-3 hover:bg-aprende-bg border-b border-aprende-secondary/50 transition-colors #{notification.read_at.nil? ? 'bg-blue-50/50' : 'opacity-70'}" do %>
                        <p class="text-sm text-aprende-text <%= notification.read_at.nil? ? 'font-medium' : '' %>"><%= notification.message %></p>
                        <span class="text-[10px] text-aprende-muted"><%= time_ago_in_words(notification.created_at) %> atrás</span>
                      <% end %>
                    <% end %>
                  <% else %>
                    <div class="p-4 text-center text-sm text-aprende-muted">Sem notificações no momento.</div>
                  <% end %>
                </div>
              </div>
            </div>

            <%= link_to current_user.student? ? student_path(current_user) : teacher_path(current_user), class: "flex items-center gap-2 group" do %>
              <%= user_avatar(current_user, size: "w-8 h-8 md:w-8 md:h-8", text_size: "text-xs") %>
              <span class="text-aprende-muted group-hover:text-aprende-primary font-medium transition-colors hidden sm:inline">Meu Painel</span>
            <% end %>
            <div class="hidden md:block">
              <%= button_to "Sair", logout_path, method: :delete, class: "bg-white border border-aprende-secondary hover:border-aprende-primary text-aprende-text font-medium py-1.5 px-4 rounded-full transition-all text-xs cursor-pointer" %>
            </div>
          </div>
        <% else %>
          <div class="hidden md:flex items-center gap-4">
            <%= link_to "Entrar", login_path, class: "text-aprende-muted hover:text-aprende-primary font-medium transition-colors" %>
            <%= link_to "Cadastrar", new_user_path, class: "bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-2.5 px-6 rounded-full transition-transform hover:scale-[1.02] shadow-sm text-sm" %>
          </div>
        <% end %>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-white border-b border-aprende-secondary shadow-lg z-40">
        <div class="flex flex-col px-6 py-4 gap-4">
          <% if !current_user || current_user.student? %>
            <%= link_to "Professores", teachers_path, class: "text-aprende-text font-medium py-2 border-b border-aprende-secondary/30" %>
            <% if current_user&.student? %>
              <%= link_to "Aprender com IA", learn_path, class: "text-aprende-text font-medium py-2 border-b border-aprende-secondary/30" %>
            <% end %>
          <% end %>
          <% if !current_user || current_user.teacher? %>
            <%= link_to "Alunos", students_path, class: "text-aprende-text font-medium py-2 border-b border-aprende-secondary/30" %>
            <% if current_user&.teacher? %>
              <%= link_to "Planejar com IA", plan_path, class: "text-aprende-text font-medium py-2 border-b border-aprende-secondary/30" %>
            <% end %>
          <% end %>
          <% if current_user&.admin? %>
            <%= link_to "Moderação", admin_moderation_index_path, class: "text-aprende-text font-medium py-2 border-b border-aprende-secondary/30" %>
          <% end %>
          
          <% if current_user %>
            <div class="py-2 border-b border-aprende-secondary/30">
              <button type="button" onclick="document.getElementById('mobile-notif-list').classList.toggle('hidden')" class="flex justify-between items-center w-full text-aprende-text font-medium text-left">
                <span>Notificações</span>
                <% unread_count = current_user.notifications.unread.count %>
                <% if unread_count > 0 %>
                  <span class="bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full"><%= unread_count %></span>
                <% else %>
                  <svg class="w-4 h-4 text-aprende-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                <% end %>
              </button>
              <div id="mobile-notif-list" class="hidden flex flex-col gap-3 mt-4 ml-2 border-l-2 border-aprende-secondary pl-4">
                <% notifications = current_user.notifications.recent.limit(5) %>
                <% if notifications.any? %>
                  <% notifications.each do |notification| %>
                    <%= button_to read_notification_path(notification), method: :patch, class: "text-left block w-full" do %>
                      <p class="text-sm <%= notification.read_at.nil? ? 'font-medium text-aprende-text' : 'text-aprende-muted' %>"><%= notification.message %></p>
                      <p class="text-[10px] text-aprende-muted mt-0.5"><%= time_ago_in_words(notification.created_at) %> atrás</p>
                    <% end %>
                  <% end %>
                <% else %>
                  <p class="text-sm text-aprende-muted">Nenhuma notificação.</p>
                <% end %>
              </div>
            </div>
            
            <%= button_to "Sair da conta", logout_path, method: :delete, class: "text-red-600 font-medium py-3 text-left w-full cursor-pointer mt-2" %>
          <% else %>
            <div class="flex flex-col gap-3 mt-2">
              <%= link_to "Entrar", login_path, class: "text-center text-aprende-text border border-aprende-secondary font-medium py-2.5 rounded-xl w-full" %>
              <%= link_to "Cadastrar", new_user_path, class: "text-center bg-aprende-primary text-white font-medium py-2.5 rounded-xl w-full" %>
            </div>
          <% end %>
        </div>
      </div>
    </nav>

    <% if flash[:notice] %>
      <div class="bg-aprende-secondary text-aprende-text px-6 py-3 border-b border-aprende-primary text-center font-medium">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="bg-red-50 text-red-700 px-6 py-3 border-b border-red-200 text-center font-medium">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <main class="flex-1 w-full max-w-7xl mx-auto p-6">
      <%= yield %>
    </main>
  </body>
</html>
