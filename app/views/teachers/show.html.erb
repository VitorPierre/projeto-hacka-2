<div class="max-w-4xl mx-auto w-full flex flex-col gap-6">
  <h2 class="text-2xl md:text-3xl font-medium text-aprende-text px-2"><%= current_user == @teacher ? "Painel do Professor" : "Perfil do Professor: #{@teacher.name}" %></h2>
  <!-- Perfil Card -->
  <div class="bg-white rounded-[1.5rem] shadow-sm border border-aprende-secondary p-6 md:p-8 flex flex-col gap-6">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
      <div>
        <h1 class="text-2xl md:text-3xl font-medium text-aprende-text"><%= @teacher.name %></h1>
        <p class="text-aprende-primary font-medium mt-1"><%= @teacher.education_level.humanize %></p>
        
        <div class="flex flex-col gap-4 mt-6">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <p class="text-sm text-aprende-muted font-medium">Especialidades</p>
                <% if current_user == @teacher %>
                  <button onclick="document.getElementById('edit_subjects').classList.toggle('hidden')" class="text-sm text-aprende-primary border border-aprende-primary rounded-full px-3 py-1 hover:bg-aprende-bg transition-colors"> 
                  + Editar
                  </button>
                <% end %>
            </div>
          <div>
            <div class="flex flex-wrap gap-2 mb-3">
              <% if @teacher.subjects.any? %>
                <% @teacher.subjects.each do |subject| %>
                  <span class="bg-aprende-bg border border-aprende-secondary text-aprende-text text-xs px-3 py-1.5 rounded-full font-medium"><%= subject.name %></span>
                  <% end %>
                <% else %>
                  <p class="text-sm text-aprende-muted italic">Nenhuma especialidade adicionada.</p>
              <% end %>
            </div>
            <% if current_user == @teacher %>
              <div id="edit_subjects" class="hidden mt-4 border border-aprende-secondary rounded-xl p-4 bg-aprende-bg">
                  <p class="text-sm font-medium text-aprende-primary mb-3">Selecione suas especialidades:</p>
                <%= form_with url: update_subjects_teacher_path(@teacher), method: :patch, local: true do |f| %> 
                  <div class="flex flex-wrap gap-2 max-h-64 overflow-y-auto pr-1">
                      <% Subject.all.each do |subject| %>
                        <label class="flex items-center gap-2 cursor-pointer hover:bg-white rounded-lg px-2 py-1.5 transition-colors">
                         <input type="checkbox" name="subject_ids[]" value="<%= subject.id %>"
                          <%= @teacher.subject_ids.include?(subject.id) ? "checked" : '' %>
                           class="h-4 w-4 text-aprende-primary rounded border-aprende-secondary focus:ring-aprende-primary">
                          <span class="text-sm text-aprende-text"><%= subject.name %></span>
                        </label>
                      <% end %>
                  </div>
                  <div class="mt-4 flex justify-end">
                    <%= f.submit "Salvar especialidades", class: "bg-aprende-primary hover:bg-[#159b3f] text-white text-sm font-medium py-2 px-6 rounded-xl transition-colors cursor-pointer" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
                 
          </div>
          <% if @teacher.certified? %>
            <div class="inline-flex items-center gap-2 bg-[#e8f6ed] text-[#0f6b2e] px-4 py-2 rounded-full text-sm font-medium border border-[#c2e8cf] self-start">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Professor Certificado
            </div>
          <% end %>
        </div>
      </div>
      
      <% if current_user && current_user.student? && current_user != @teacher %>
        <% active_proposal = Proposal.where(student_id: current_user.id, teacher_id: @teacher.id).where(status: [:pending, :accepted]).first %>
        <% if active_proposal %>
          <%= link_to proposal_path(active_proposal), class: "w-full md:w-auto text-center bg-white border-2 border-aprende-primary text-aprende-primary hover:bg-aprende-bg font-medium py-3 px-8 rounded-xl transition-colors flex items-center justify-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            Negociação em andamento
          <% end %>
        <% else %>
          <%= link_to new_proposal_path(teacher_id: @teacher.id), class: "w-full md:w-auto text-center bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 px-8 rounded-xl transition-colors cursor-pointer flex items-center justify-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
            Fazer Proposta
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Painel do Professor (Apenas se for o próprio) -->
  <% if current_user == @teacher %>
    <div class="flex flex-col gap-4 mt-2">
      <h2 class="text-xl md:text-2xl font-medium text-aprende-text px-2">Propostas Recebidas</h2>
      
      <% if @teacher.received_proposals.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @teacher.received_proposals.each do |proposal| %>
            <div class="bg-white rounded-xl shadow-sm border border-aprende-secondary p-5 flex flex-col gap-3">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <p class="font-medium text-aprende-text"><%= proposal.student.name %></p>
                  <p class="text-sm text-aprende-muted"><%= proposal.subject.name %></p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-xs text-aprende-muted">Proposta</p>
                  <p class="font-bold text-lg text-aprende-primary mt-1"><%= number_to_currency(proposal.price) %></p>
                </div>
              </div>
              <div class="pt-3 border-t border-aprende-secondary mt-auto flex justify-between items-center">
                <span class="inline-block px-3 py-1 text-xs font-medium rounded-full <%= proposal.status == 'pending' ? 'bg-yellow-50 text-yellow-700 border border-yellow-200' : 'bg-aprende-bg text-aprende-primary border border-aprende-primary' %>">
                  <%= proposal.status.humanize %>
                </span>
                <%= link_to "Ver Detalhes / Chat", proposal_path(proposal), class: "text-sm text-aprende-primary hover:text-[#159b3f] font-medium" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white border border-aprende-secondary rounded-xl p-8 text-center shadow-sm">
          <p class="text-aprende-muted">Você ainda não recebeu propostas.</p>
        </div>
      <% end %>

      <% if @teacher.subjects.any? %>
        <% compatible_students = User.student.includes(:subjects).select { |s| (s.subject_ids & @teacher.subject_ids).any? } %>
        <div class="mt-6">
          <h2 class="text-xl md:text-2xl font-medium text-aprende-text px-2">Alunos compatíveis com suas especialidades</h2>
          <% if compatible_students.any? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
              <% compatible_students.first(5).each do |student| %>
                <% match_count = (student.subject_ids & @teacher.subject_ids).count %>
                <% total = student.subject_ids.count %>
                <% percent = total.positive? ? (match_count.to_f / total * 100).round : 0 %>
                <%= link_to student_path(student), class: "bg-white border border-aprende-secondary rounded-xl p-4 flex items-center justify-between hover:border-aprende-primary transition-colors" do %>
                  <div class="space-y-2">
                    <p class="font-medium text-aprende-text"><%= student.name %></p>
                    <div class="flex flex-wrap gap-2">
                      <% (student.subject_ids & @teacher.subject_ids).each do |subject_id| %>
                        <% subject = Subject.find(subject_id) %>
                        <span class="bg-aprende-bg border border-aprende-secondary text-aprende-text text-xs px-2 py-0.5 rounded-full"><%= subject.name %></span>
                      <% end %>
                    </div>
                  </div>
                  <div class="text-right">
                    <p class="text-2xl font-medium text-aprende-primary"><%= percent %>%</p>
                    <p class="text-xs text-aprende-muted">match</p>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="text-aprende-muted italic mt-4">Nenhum aluno compatível encontrado.</p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
