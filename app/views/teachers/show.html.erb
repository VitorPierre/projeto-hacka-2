<div class="max-w-4xl mx-auto w-full flex flex-col gap-6">
  <h1 class="text-2xl md:text-3xl font-medium text-aprende-text px-2"><%= current_user == @teacher ? "Painel do Professor" : "Perfil do Professor: #{@teacher.name}" %></h1>
  <!-- Perfil Card -->
  <div class="bg-white rounded-[1.5rem] shadow-sm border border-aprende-secondary p-6 md:p-8 flex flex-col gap-6">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
      <div class="flex-1">
        <div class="flex items-center gap-6">
          <%= user_avatar(@teacher, size: "w-20 h-20 md:w-24 md:h-24", text_size: "text-3xl") %>
          <div class="flex-1">
            <div class="flex items-center gap-4">
              <h2 class="text-2xl md:text-3xl font-medium text-aprende-text"><%= @teacher.name %></h2>
              <% if current_user == @teacher %>
                <%= link_to edit_user_path(@teacher), class: "text-aprende-muted hover:text-aprende-primary p-1 transition-colors", title: "Editar Perfil" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                <% end %>
              <% end %>
            </div>
            <p class="text-aprende-primary font-medium mt-1">Escolaridade: <%= @teacher.education_level_human %></p>
            <% if @teacher.pcd? %>
              <div class="mt-2">
                <span class="inline-flex items-center gap-1.5 bg-[#e8f6ed] text-[#0f6b2e] px-3 py-1.5 rounded-full text-xs font-medium border border-[#c2e8cf]">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  Pessoa com Deficiência (PcD)
                </span>
              </div>
            <% end %>
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
          <div class="space-y-4">
            <div>
              <p class="text-sm text-aprende-muted mb-2 font-medium">Especialidades</p>
              <div class="flex flex-wrap gap-2">
                <% @teacher.subjects.each do |subject| %>
                  <span class="bg-aprende-bg border border-aprende-secondary text-aprende-text text-xs px-3 py-1.5 rounded-full font-medium"><%= subject.name %></span>
                <% end %>
              </div>
            </div>

            <% if @teacher.certified? %>
              <div class="inline-flex items-center gap-2 bg-[#e8f6ed] text-[#0f6b2e] px-4 py-2 rounded-full text-sm font-medium border border-[#c2e8cf] self-start">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Professor Certificado
              </div>
            <% end %>
          </div>

          <div class="space-y-4">
            <div>
              <p class="text-sm text-aprende-muted mb-2 font-medium">Experiência</p>
              <p class="text-aprende-text text-sm leading-relaxed <%= 'italic opacity-60' unless @teacher.experience.present? %>">
                <%= @teacher.experience.present? ? @teacher.experience : "Este professor ainda não detalhou sua experiência acadêmica ou profissional." %>
              </p>
            </div>
            
            <div>
              <p class="text-sm text-aprende-muted mb-2 font-medium">Preferências</p>
              <p class="text-aprende-text text-sm leading-relaxed italic">
                <%= user_preferences_display(@teacher) %>
              </p>
            </div>

            <div>
              <p class="text-sm text-aprende-muted mb-2 font-medium">Disponibilidade</p>
              <p class="text-aprende-text text-sm leading-relaxed italic">
                <%= @teacher.availability.present? ? @teacher.availability : "Horário a combinar." %>
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <% if current_user && current_user.student? && current_user != @teacher %>
        <% active_proposal = Proposal.where(student_id: current_user.id, teacher_id: @teacher.id).where(status: [:pending, :accepted]).first %>
        <% if active_proposal %>
          <%= link_to proposal_path(active_proposal), class: "w-full md:w-auto text-center bg-white border-2 border-aprende-primary text-aprende-primary hover:bg-aprende-bg font-medium py-3 px-8 rounded-xl transition-colors flex items-center justify-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            Negociação em andamento
          <% end %>
        <% else %>
          <%= link_to new_proposal_path(teacher_id: @teacher.id), class: "w-full md:w-auto text-center bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 px-8 rounded-xl transition-colors cursor-pointer flex items-center justify-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
            Fazer Proposta
          <% end %>
        <% end %>
      <% end %>
    </div>

    <% if @teacher.presentation_video_url.present? && @teacher.youtube_video_id.present? %>
      <div class="border-t border-aprende-secondary pt-6 mt-2 flex flex-col gap-3">
        <h3 class="text-base font-medium text-aprende-text">Vídeo de Apresentação</h3>
        <div class="max-w-2xl w-full aspect-video rounded-2xl overflow-hidden shadow-sm border border-aprende-secondary bg-black">
          <iframe 
            src="https://www.youtube.com/embed/<%= @teacher.youtube_video_id %>" 
            title="Vídeo de apresentação de <%= @teacher.name %>"
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin" 
            allowfullscreen
            class="w-full h-full">
          </iframe>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Painel do Professor (Apenas se for o próprio) -->
    <% if current_user == @teacher %>
      <!-- Seção Meus Agendamentos -->
      <div class="flex flex-col gap-4 mt-8">
        <h2 class="text-xl md:text-2xl font-medium text-aprende-text px-2">Meus Agendamentos</h2>
        
        <% if @scheduled_proposals && @scheduled_proposals.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% @scheduled_proposals.each do |proposal| %>
              <div class="bg-aprende-bg border border-aprende-primary/30 rounded-xl p-5 flex flex-col gap-3 shadow-sm relative overflow-hidden">
                <div class="absolute left-0 top-0 bottom-0 w-1 <%= proposal.started_at? ? 'bg-red-500' : 'bg-aprende-primary' %>"></div>
                <div class="flex justify-between items-start gap-4">
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide <%= proposal.started_at? ? 'text-red-500' : 'text-aprende-muted' %>">
                      <%= proposal.started_at? ? "Sessão Ativa (Em andamento)" : "Agendado para" %>
                    </p>
                    <p class="font-bold text-aprende-text mt-1">
                      <%= I18n.l(proposal.scheduled_at.to_time, format: :long) rescue proposal.scheduled_at %>
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-3 mt-2">
                  <%= user_avatar(proposal.student, size: "w-8 h-8", text_size: "text-xs") %>
                  <div>
                    <p class="font-medium text-aprende-text text-sm"><%= proposal.student.name %></p>
                    <p class="text-xs text-aprende-muted"><%= proposal.subject.name %></p>
                  </div>
                </div>
                <div class="pt-3 border-t border-aprende-secondary mt-2 flex justify-between items-center">
                  <%= link_to proposal.started_at? ? "Voltar para a Sala" : "Ver Detalhes / Iniciar", proposal_path(proposal), class: "text-sm #{proposal.started_at? ? 'bg-red-50 text-red-600 border-red-200 hover:bg-red-100' : 'text-aprende-primary hover:bg-gray-50 border-aprende-secondary'} font-medium w-full text-center bg-white border py-2 rounded-lg transition-colors" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="bg-white border border-aprende-secondary border-dashed rounded-[1.5rem] p-10 text-center shadow-sm flex flex-col items-center justify-center gap-3">
            <div class="w-12 h-12 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center text-aprende-primary">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
            <p class="text-aprende-text font-semibold text-sm">Nenhum agendamento ativo</p>
            <p class="text-aprende-muted text-xs max-w-sm leading-relaxed">Você não possui nenhuma mentoria ou aula síncrona agendada para os próximos dias.</p>
          </div>
        <% end %>
      </div>

      <!-- Seção Alunos Lecionados -->
      <div class="flex flex-col gap-4 mt-6">
        <h2 class="text-xl md:text-2xl font-medium text-aprende-text px-2">Alunos que já leciono</h2>
        
        <% taught_proposals = @teacher.proposals_as_teacher.where(status: [:accepted, :closed]).includes(:student, :subject).order(created_at: :desc) %>
        <% if taught_proposals.any? %>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <% taught_proposals.first(3).each do |prop| %>
              <div class="bg-white rounded-xl shadow-sm border border-aprende-secondary p-4 flex flex-col gap-2">
                <div class="flex items-center gap-3">
                  <%= user_avatar(prop.student, size: "w-10 h-10", text_size: "text-sm") %>
                  <div>
                    <p class="font-medium text-aprende-text text-sm"><%= prop.student.name %></p>
                    <p class="text-xs text-aprende-muted"><%= prop.subject.name %></p>
                  </div>
                </div>
                <%= link_to "Ver Perfil", student_path(prop.student), class: "mt-2 text-xs text-center border border-aprende-secondary hover:border-aprende-primary py-1.5 rounded-lg transition-colors text-aprende-muted hover:text-aprende-primary" %>
              </div>
            <% end %>
          </div>
          <% if taught_proposals.count > 3 %>
            <details class="group mt-2">
              <summary class="text-sm text-aprende-primary font-medium cursor-pointer list-none flex items-center justify-center gap-1 hover:underline">
                <span>Ver todos os alunos (<%= taught_proposals.count %>)</span>
                <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </summary>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
                <% taught_proposals.drop(3).each do |prop| %>
                  <div class="bg-white rounded-xl shadow-sm border border-aprende-secondary p-4 flex flex-col gap-2">
                    <div class="flex items-center gap-3">
                      <%= user_avatar(prop.student, size: "w-10 h-10", text_size: "text-sm") %>
                      <div>
                        <p class="font-medium text-aprende-text text-sm"><%= prop.student.name %></p>
                        <p class="text-xs text-aprende-muted"><%= prop.subject.name %></p>
                      </div>
                    </div>
                    <%= link_to "Ver Perfil", student_path(prop.student), class: "mt-2 text-xs text-center border border-aprende-secondary hover:border-aprende-primary py-1.5 rounded-lg transition-colors text-aprende-muted hover:text-aprende-primary" %>
                  </div>
                <% end %>
              </div>
            </details>
          <% end %>
        <% else %>
          <div class="bg-white border border-aprende-secondary border-dashed rounded-[1.5rem] p-10 text-center shadow-sm flex flex-col items-center justify-center gap-3">
            <div class="w-12 h-12 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center text-aprende-primary">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
            <p class="text-aprende-text font-semibold text-sm">Nenhum aluno lecionado</p>
            <p class="text-aprende-muted text-xs max-w-sm leading-relaxed">Você ainda não possui alunos vinculados por meio de propostas aceitas.</p>
          </div>
        <% end %>
      </div>

      <div class="flex flex-col gap-4 mt-8">
        <h2 class="text-xl md:text-2xl font-medium text-aprende-text px-2">Minhas Propostas</h2>
        
        <% 
          all_proposals = @teacher.all_proposals.includes(:student, :teacher, :subject, :sender).order(created_at: :desc).to_a
          visible_proposals = all_proposals.select { |p| p.pending? || p.accepted? } + all_proposals.select(&:closed?).first(2)
          hidden_proposals = all_proposals - visible_proposals
        %>
      <% if all_proposals.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% visible_proposals.each do |proposal| %>
            <div class="bg-white rounded-xl shadow-sm border border-aprende-secondary p-5 flex flex-col gap-3">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <p class="text-xs font-semibold text-aprende-primary"><%= proposal.proposal_type_human %></p>
                  <p class="font-medium text-aprende-text"><%= proposal.student.name %></p>
                  <p class="text-sm text-aprende-muted"><%= proposal.subject.name %></p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-xs text-aprende-muted">Proposta</p>
                  <p class="font-bold text-lg text-aprende-primary mt-1"><%= number_to_currency(proposal.price) %></p>
                </div>
              </div>
              <div class="pt-3 border-t border-aprende-secondary mt-auto flex justify-between items-center">
                <div class="flex flex-col gap-1">
                  <span class="inline-block px-3 py-1 text-xs font-medium rounded-full <%= proposal.status == 'pending' ? 'bg-yellow-50 text-yellow-700 border border-yellow-200' : 'bg-aprende-bg text-aprende-primary border border-aprende-primary' %>">
                    <%= proposal.status_human %>
                  </span>
                  <span class="text-xs text-aprende-muted">
                    <%= proposal.sender_id == @teacher.id ? "Enviada por você" : "Recebida do aluno" %>
                  </span>
                </div>
                <%= link_to "Ver Detalhes / Chat", proposal_path(proposal), class: "text-sm text-aprende-primary hover:text-[#159b3f] font-medium" %>
              </div>
            </div>
          <% end %>
        </div>
        
        <% if hidden_proposals.any? %>
          <details class="group mt-2">
            <summary class="text-sm text-aprende-primary font-medium cursor-pointer list-none flex items-center justify-center gap-1 hover:underline">
              <span>Ver histórico completo (<%= hidden_proposals.count %>)</span>
              <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
              <% hidden_proposals.each do |proposal| %>
                <div class="bg-gray-50 rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col gap-3">
                  <div class="flex justify-between items-start gap-4">
                    <div>
                      <p class="text-xs font-semibold text-aprende-primary"><%= proposal.proposal_type_human %></p>
                      <p class="font-medium text-gray-800"><%= proposal.student.name %></p>
                      <p class="text-sm text-gray-500"><%= proposal.subject.name %></p>
                    </div>
                    <div class="text-right flex-shrink-0">
                      <p class="text-xs text-gray-500">Proposta</p>
                      <p class="font-bold text-lg text-gray-700 mt-1"><%= number_to_currency(proposal.price) %></p>
                    </div>
                  </div>
                  <div class="pt-3 border-t border-gray-200 mt-auto flex justify-between items-center">
                    <div class="flex flex-col gap-1">
                      <span class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-600 border border-gray-200">
                        <%= proposal.status_human %>
                      </span>
                    </div>
                    <%= link_to "Ver Histórico", proposal_path(proposal), class: "text-sm text-gray-500 hover:text-gray-700 font-medium" %>
                  </div>
                </div>
              <% end %>
            </div>
          </details>
        <% end %>
      <% else %>
        <div class="bg-white border border-aprende-secondary border-dashed rounded-[1.5rem] p-10 text-center shadow-sm flex flex-col items-center justify-center gap-3">
          <div class="w-12 h-12 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center text-aprende-primary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <p class="text-aprende-text font-semibold text-sm">Nenhuma proposta ativa</p>
          <p class="text-aprende-muted text-xs max-w-sm leading-relaxed">Não há registros de propostas enviadas ou recebidas em seu perfil.</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
