<div class="mb-6 md:mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
  <div>
    <h2 class="text-2xl md:text-3xl font-medium text-aprende-text">Professores Disponíveis</h2>
    <p class="text-aprende-muted mt-2">Escolha o profissional ideal e envie uma proposta de aula.</p>
  </div>
  <%= render 'subjects/manager', url: teachers_path, blank_label: "Todas as Especialidades" %>
</div>

<% if @teachers.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
    <% @teachers.each do |teacher| %>
      <div class="bg-white rounded-[1.5rem] shadow-sm border border-aprende-secondary p-6 md:p-8 flex flex-col h-full gap-4">
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <%= user_avatar(teacher, size: "w-14 h-14", text_size: "text-xl") %>
            <div>
              <h3 class="text-xl font-medium text-aprende-text"><%= teacher.name %></h3>
              <p class="text-aprende-primary font-medium text-sm">Escolaridade: <%= teacher.education_level_human %></p>
              <% if teacher.technical? || teacher.higher? %>
                <p class="text-[10px] text-aprende-muted font-medium uppercase tracking-wider">Valor mínimo: R$ 50,00</p>
              <% end %>
            </div>
          </div>
          
          <% if teacher.certified? %>
            <div class="inline-flex items-center gap-1.5 text-xs text-[#0f6b2e] font-medium mt-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Certificado
            </div>
          <% end %>

          <div class="flex gap-2 items-center mt-1">
            <% if teacher.ratings_count > 0 %>
              <div class="inline-flex items-center gap-1 text-xs font-medium text-yellow-700 bg-yellow-50 px-2.5 py-1 rounded-md border border-yellow-200">
                <svg class="w-3.5 h-3.5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                <%= teacher.average_rating %> (<%= teacher.ratings_count %> <%= teacher.ratings_count == 1 ? 'aula' : 'aulas' %>)
              </div>
            <% else %>
              <div class="inline-flex items-center gap-1 text-xs font-medium text-gray-500 bg-gray-50 px-2.5 py-1 rounded-md border border-gray-200">
                <svg class="w-3.5 h-3.5 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                Novo
              </div>
            <% end %>
          </div>

          <% if teacher.subjects.any? %>
            <div class="mt-4">
              <p class="text-sm text-aprende-muted mb-3 font-medium">Especialidades</p>
              <div class="flex flex-wrap gap-2">
                <% teacher.subjects.each do |subject| %>
                  <span class="bg-aprende-bg border border-aprende-secondary text-aprende-text text-xs px-3 py-1.5 rounded-full font-medium"><%= subject.name %></span>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="mt-4">
            <p class="text-sm text-aprende-muted mb-2 font-medium">Objetivos</p>
            <p class="text-aprende-text text-xs leading-relaxed italic line-clamp-3">
              <%= user_preferences_display(teacher, truncated: true) %>
            </p>
          </div>

          <div class="mt-4">
            <p class="text-sm text-aprende-muted mb-2 font-medium">Disponibilidade</p>
            <p class="text-aprende-text text-xs leading-relaxed italic">
              <%= teacher.availability.present? ? teacher.availability : "Horário a combinar." %>
            </p>
          </div>
        </div>

        <div class="mt-auto pt-6 border-t border-aprende-secondary flex flex-col gap-3">
          <% if current_user&.student? %>
            <%= link_to "Fazer Proposta", new_proposal_path(teacher_id: teacher.id), class: "block w-full text-center bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 rounded-xl transition-colors" %>
          <% elsif !current_user %>
            <%= link_to "Entrar para Fazer Proposta", login_path, class: "block w-full text-center bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 rounded-xl transition-colors" %>
          <% else %>
            <%= link_to "Ver Perfil", teacher_path(teacher), class: "block w-full text-center bg-white border border-aprende-secondary hover:bg-aprende-bg text-aprende-text font-medium py-3 rounded-xl transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white border border-aprende-secondary rounded-xl p-8 text-center shadow-sm">
    <p class="text-aprende-muted"><%= params[:subject_id].present? ? "Nenhum professor encontrado para esta especialidade." : "Nenhum professor disponível ainda." %></p>
    <% if params[:subject_id].present? %>
      <%= link_to "Limpar Filtro", teachers_path, class: "mt-4 inline-block text-aprende-primary hover:underline text-sm font-medium" %>
    <% end %>
  </div>
<% end %>
