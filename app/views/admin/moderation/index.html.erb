<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex flex-col gap-6">
    <!-- Cabeçalho Principal -->
    <div class="bg-white p-6 md:p-8 rounded-[1.5rem] border border-aprende-secondary flex flex-col md:flex-row md:items-center md:justify-between gap-4 shadow-sm">
      <div>
        <h1 class="text-3xl font-bold text-aprende-text tracking-tight flex items-center gap-2">
          <svg class="w-8 h-8 text-aprende-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          Painel de Moderação
        </h1>
        <p class="text-aprende-muted mt-1 text-sm md:text-base">Administração e revisão de perfis com termos suspeitos ou impróprios.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to admin_audit_logs_path, class: "bg-white text-aprende-primary hover:text-[#159b3f] hover:border-aprende-primary font-semibold px-5 py-2.5 rounded-full border border-aprende-secondary text-sm flex items-center gap-1.5 shadow-sm transition-all hover:scale-[1.02] cursor-pointer" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
          Histórico de Auditoria
        <% end %>
        <span class="bg-aprende-bg text-aprende-primary font-semibold px-4 py-2 rounded-full border border-aprende-secondary text-sm flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          <%= @users.size %> perfil(is) listado(s)
        </span>
      </div>
    </div>

    <!-- Navegação de Abas e Filtros -->
    <div class="bg-white p-6 rounded-[1.5rem] border border-aprende-secondary flex flex-col gap-6 shadow-sm">
      <!-- Abas -->
      <div class="flex border-b border-aprende-secondary/40 pb-2 gap-6 overflow-x-auto">
        <%= link_to admin_moderation_index_path(tab: 'suspicious', search: params[:search], status_filter: params[:status_filter]), 
            class: "pb-2 px-1 text-sm font-bold border-b-2 transition-all flex items-center gap-2 #{@tab == 'suspicious' ? 'border-aprende-primary text-aprende-primary scale-[1.02]' : 'border-transparent text-aprende-muted hover:text-aprende-text'}" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          Perfis Suspeitos (Flagrados)
        <% end %>

        <%= link_to admin_moderation_index_path(tab: 'all', search: params[:search], status_filter: params[:status_filter]), 
            class: "pb-2 px-1 text-sm font-bold border-b-2 transition-all flex items-center gap-2 #{@tab == 'all' ? 'border-aprende-primary text-aprende-primary scale-[1.02]' : 'border-transparent text-aprende-muted hover:text-aprende-text'}" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          Todos os Usuários da Plataforma
        <% end %>
      </div>

      <!-- Barra de Busca e Filtro de Status -->
      <%= form_with url: admin_moderation_index_path, method: :get, local: true, class: "flex flex-col md:flex-row items-center gap-3 w-full" do |f| %>
        <%= hidden_field_tag :tab, @tab %>
        
        <div class="flex-1 w-full relative">
          <%= f.text_field :search, value: params[:search], placeholder: "Buscar por nome ou e-mail...", 
              class: "w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-aprende-primary focus:ring-1 focus:ring-aprende-primary text-sm text-aprende-text placeholder-aprende-muted transition" %>
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.604 10.604Z" />
            </svg>
          </div>
        </div>

        <div class="w-full md:w-56">
          <%= f.select :status_filter, [["Todos os Statuses", ""], ["Ativo", "active"], ["Suspenso", "suspended"], ["Banido", "banned"]], { selected: params[:status_filter] }, 
              class: "w-full px-3 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-aprende-primary focus:ring-1 focus:ring-aprende-primary text-sm text-aprende-text cursor-pointer transition" %>
        </div>

        <div class="flex items-center gap-2 w-full md:w-auto">
          <%= f.submit "Filtrar", class: "w-full md:w-auto bg-aprende-primary hover:bg-[#159b3f] text-white font-medium px-6 py-3 rounded-xl text-sm transition-all hover:scale-[1.02] shadow-sm cursor-pointer" %>
          <% if params[:search].present? || params[:status_filter].present? %>
            <%= link_to "Limpar", admin_moderation_index_path(tab: @tab), class: "w-full md:w-auto text-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-5 py-3 rounded-xl text-sm transition-all hover:scale-[1.02]" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @users.empty? %>
      <!-- Estado Vazio -->
      <div class="bg-white p-12 rounded-[1.5rem] border border-aprende-secondary text-center flex flex-col items-center justify-center gap-4 shadow-sm">
        <div class="w-16 h-16 bg-aprende-bg rounded-full flex items-center justify-center border border-aprende-secondary text-aprende-primary">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h2 class="text-xl font-bold text-aprende-text">Nenhum resultado encontrado</h2>
        <p class="text-aprende-muted max-w-md text-sm leading-relaxed">Não encontramos nenhum usuário correspondente aos filtros activos nesta aba no momento.</p>
      </div>
    <% else %>
      <!-- Ações em Lote e Listagem -->
      <%= form_tag batch_action_admin_moderation_index_path, method: :post, id: "batch-form" do %>
        <%= hidden_field_tag :tab, @tab %>
        <%= hidden_field_tag :search, params[:search] %>
        <%= hidden_field_tag :status_filter, params[:status_filter] %>

        <!-- Barra de Ferramentas de Lote -->
        <div class="bg-white p-5 rounded-[1.5rem] border border-aprende-secondary flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 shadow-sm mb-6">
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2.5 cursor-pointer font-medium text-sm text-aprende-text select-none">
              <input type="checkbox" id="select-all" class="w-5 h-5 rounded text-aprende-primary focus:ring-aprende-primary border-slate-300 cursor-pointer">
              Selecionar Todos
            </label>
            <span id="selected-count" class="text-xs bg-aprende-bg border border-aprende-secondary text-aprende-primary px-2.5 py-1 rounded-full font-bold hidden transition-all">
              0 selecionado(s)
            </span>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs text-aprende-muted mr-1 font-semibold uppercase tracking-wider">Ações em lote:</span>
            <button type="submit" name="action_type" value="mark_safe" class="bg-aprende-bg text-aprende-primary hover:bg-aprende-secondary/40 border border-aprende-secondary px-3.5 py-2 rounded-xl text-xs font-bold transition-all hover:scale-[1.02] flex items-center gap-1.5 cursor-pointer shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              Marcar como Seguro
            </button>
            <button type="submit" name="action_type" value="suspend" class="bg-yellow-50 text-yellow-700 hover:bg-yellow-100 border border-yellow-200 px-3.5 py-2 rounded-xl text-xs font-bold transition-all hover:scale-[1.02] flex items-center gap-1.5 cursor-pointer shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              Suspender
            </button>
            <button type="submit" name="action_type" value="ban" class="bg-red-50 text-red-700 hover:bg-red-100 border border-red-200 px-3.5 py-2 rounded-xl text-xs font-bold transition-all hover:scale-[1.02] flex items-center gap-1.5 cursor-pointer shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
              Banir
            </button>
          </div>
        </div>

        <!-- Lista de Perfis Flagrados -->
        <div class="flex flex-col gap-6">
          <% @users.each do |user| %>
            <div class="bg-white p-6 rounded-[1.5rem] border border-aprende-secondary shadow-sm hover:shadow-md transition-all duration-200 flex flex-col lg:flex-row gap-6 items-start lg:items-center">
              
              <!-- Checkbox e Info Gerais do Usuário -->
              <div class="flex items-center gap-4 min-w-[260px] w-full lg:w-auto">
                <div class="flex items-center">
                  <input type="checkbox" name="user_ids[]" value="<%= user.id %>" class="user-checkbox w-5 h-5 rounded text-aprende-primary focus:ring-aprende-primary border-slate-300 cursor-pointer">
                </div>
                <%= user_avatar(user, size: "w-14 h-14", text_size: "text-lg") %>
                <div class="flex flex-col gap-1.5">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full border <%= user.student? ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-blue-50 text-blue-700 border-blue-200' %>">
                      <%= user.student? ? 'Estudante' : 'Professor' %>
                    </span>
                    <% if user.suspended? %>
                      <span class="text-[10px] font-bold uppercase tracking-wider bg-yellow-50 text-yellow-700 px-2 py-0.5 rounded-full border border-yellow-200">Suspenso</span>
                    <% elsif user.banned? %>
                      <span class="text-[10px] font-bold uppercase tracking-wider bg-red-50 text-red-700 px-2 py-0.5 rounded-full border border-red-200">Banido</span>
                    <% else %>
                      <span class="text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full border border-emerald-200">Ativo</span>
                    <% end %>
                  </div>
                  <div class="text-xs text-aprende-muted font-mono"><%= user.email %></div>
                </div>
              </div>

              <!-- Campos Suspeitos com Destaque dos Erros -->
              <div class="flex-1 w-full flex flex-col gap-3 bg-aprende-bg/30 p-5 rounded-2xl border border-aprende-secondary/50">
                <div class="text-xs font-semibold text-aprende-muted uppercase tracking-wider border-b border-aprende-secondary/30 pb-1.5 mb-1 flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-aprende-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  Campos Analisados e Destaques
                </div>
                
                <!-- Nome -->
                <div class="text-sm flex flex-col sm:flex-row sm:items-start gap-2">
                  <strong class="sm:min-w-[120px] text-xs font-bold text-aprende-text uppercase tracking-wider mt-1 select-none">Nome:</strong>
                  <span class="text-slate-800 bg-white px-3 py-1.5 rounded-xl border border-slate-100 shadow-sm w-full"><%= highlight_inappropriate(user.name) %></span>
                </div>

                <!-- Disponibilidade -->
                <% if user.availability.present? %>
                  <div class="text-sm flex flex-col sm:flex-row sm:items-start gap-2">
                    <strong class="sm:min-w-[120px] text-xs font-bold text-aprende-text uppercase tracking-wider mt-1 select-none">Disponibilidade:</strong>
                    <span class="text-slate-600 bg-white px-3 py-1.5 rounded-xl border border-slate-100 shadow-sm w-full leading-relaxed"><%= highlight_inappropriate(user.availability) %></span>
                  </div>
                <% end %>

                <!-- Experiência -->
                <% if user.experience.present? %>
                  <div class="text-sm flex flex-col sm:flex-row sm:items-start gap-2">
                    <strong class="sm:min-w-[120px] text-xs font-bold text-aprende-text uppercase tracking-wider mt-1 select-none">Experiência:</strong>
                    <span class="text-slate-600 bg-white px-3 py-1.5 rounded-xl border border-slate-100 shadow-sm w-full leading-relaxed"><%= highlight_inappropriate(user.experience) %></span>
                  </div>
                <% end %>

                <!-- Preferências -->
                <% if user.preferences.present? %>
                  <div class="text-sm flex flex-col sm:flex-row sm:items-start gap-2">
                    <strong class="sm:min-w-[120px] text-xs font-bold text-aprende-text uppercase tracking-wider mt-1 select-none">Preferências:</strong>
                    <span class="text-slate-600 bg-white px-3 py-1.5 rounded-xl border border-slate-100 shadow-sm w-full leading-relaxed"><%= highlight_inappropriate(user.preferences) %></span>
                  </div>
                <% end %>
              </div>

              <!-- Ações Individuais (Edição de Nome e Status) -->
              <div class="flex flex-col gap-4 w-full lg:w-72 self-stretch justify-between">
                <!-- Mini Formulário Inline para Editar o Nome -->
                <%= form_tag update_user_admin_moderation_index_path, method: :patch, class: "w-full flex flex-col gap-1.5" do %>
                  <%= hidden_field_tag :user_id, user.id %>
                  <%= hidden_field_tag :tab, @tab %>
                  <%= hidden_field_tag :search, params[:search] %>
                  <%= hidden_field_tag :status_filter, params[:status_filter] %>

                  <label class="text-[10px] font-bold text-aprende-muted uppercase tracking-wider select-none">Ação Corretiva (Editar Nome)</label>
                  <div class="flex gap-2 items-center w-full">
                    <input type="text" name="name" value="<%= user.name %>" required class="flex-1 px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-aprende-primary focus:ring-1 focus:ring-aprende-primary">
                    <button type="submit" class="bg-aprende-primary text-white hover:bg-[#159b3f] px-4 py-2 rounded-xl text-xs font-bold transition-all hover:scale-[1.02] cursor-pointer shadow-sm">
                      Salvar
                    </button>
                  </div>
                <% end %>

                <!-- Botões Rápidos de Ação de Linha -->
                <div class="flex flex-col gap-1.5 w-full mt-auto">
                  <label class="text-[10px] font-bold text-aprende-muted uppercase tracking-wider select-none">Moderação de Perfil</label>
                  <div class="grid grid-cols-2 gap-2 w-full">
                    <!-- Marcar como Seguro -->
                    <%= button_to update_user_admin_moderation_index_path(user_id: user.id, moderation_status: :reviewed_safe, tab: @tab, search: params[:search], status_filter: params[:status_filter]), method: :patch, class: "w-full py-2 bg-aprende-bg text-aprende-primary hover:bg-aprende-secondary/40 border border-aprende-secondary rounded-xl text-xs font-bold transition-all text-center cursor-pointer flex items-center justify-center gap-1 shadow-sm" do %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                      Seguro
                    <% end %>

                    <!-- Suspender -->
                    <% if user.active? || user.banned? %>
                      <%= button_to update_user_admin_moderation_index_path(user_id: user.id, status: :suspended, tab: @tab, search: params[:search], status_filter: params[:status_filter]), method: :patch, class: "w-full py-2 bg-yellow-50 text-yellow-700 hover:bg-yellow-100 border border-yellow-200 rounded-xl text-xs font-bold transition-all text-center cursor-pointer flex items-center justify-center gap-1 shadow-sm" do %>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        Suspender
                      <% end %>
                    <% end %>

                    <!-- Banir -->
                    <% if user.active? || user.suspended? %>
                      <%= button_to update_user_admin_moderation_index_path(user_id: user.id, status: :banned, tab: @tab, search: params[:search], status_filter: params[:status_filter]), method: :patch, class: "w-full py-2 bg-red-50 text-red-700 hover:bg-red-100 border border-red-200 rounded-xl text-xs font-bold transition-all text-center cursor-pointer flex items-center justify-center gap-1 shadow-sm" do %>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                        Banir
                      <% end %>
                    <% end %>
                    
                    <!-- Ativar (caso esteja suspenso ou banido e precise voltar) -->
                    <% unless user.active? %>
                      <%= button_to update_user_admin_moderation_index_path(user_id: user.id, status: :active, tab: @tab, search: params[:search], status_filter: params[:status_filter]), method: :patch, class: "w-full py-2 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 rounded-xl text-xs font-bold transition-all text-center cursor-pointer flex items-center justify-center gap-1 shadow-sm" do %>
                        Reativar
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>

            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const selectAllCheckbox = document.getElementById("select-all");
    const userCheckboxes = document.querySelectorAll(".user-checkbox");
    const selectedCountSpan = document.getElementById("selected-count");

    if (selectAllCheckbox) {
      selectAllCheckbox.addEventListener("change", function() {
        userCheckboxes.forEach(cb => {
          cb.checked = selectAllCheckbox.checked;
        });
        updateCount();
      });
    }

    userCheckboxes.forEach(cb => {
      cb.addEventListener("change", function() {
        if (!cb.checked) {
          selectAllCheckbox.checked = false;
        } else {
          const allChecked = Array.from(userCheckboxes).every(c => c.checked);
          selectAllCheckbox.checked = allChecked;
        }
        updateCount();
      });
    });

    function updateCount() {
      const checkedCount = Array.from(userCheckboxes).filter(c => c.checked).length;
      if (checkedCount > 0) {
        selectedCountSpan.textContent = `${checkedCount} selecionado(s)`;
        selectedCountSpan.classList.remove("hidden");
      } else {
        selectedCountSpan.classList.add("hidden");
      }
    }
  });
</script>
