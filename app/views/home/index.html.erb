<div class="max-w-4xl mx-auto pb-12 flex flex-col gap-6 w-full">
  <!-- Search Hero Card -->
  <div class="bg-white border border-aprende-secondary rounded-[1.5rem] p-6 md:p-8 shadow-sm flex flex-col gap-6">
    <div>
      <p class="text-aprende-muted font-medium text-sm mb-2 lowercase tracking-wide">conecte-se a quem ensina</p>
      <h1 class="text-3xl md:text-4xl font-medium text-aprende-text leading-tight tracking-tight">
        Encontre o professor <span class="text-aprende-primary font-medium">certo</span> para o que você quer aprender
      </h1>
    </div>
    
    <form action="<%= teachers_path %>" method="get" class="flex flex-col md:flex-row gap-3">
      <div class="flex-1 relative">
        <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-aprende-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input type="text" name="q" placeholder="buscar matéria ou professor..." class="w-full pl-12 pr-4 py-3.5 rounded-xl border border-aprende-secondary bg-aprende-bg text-aprende-text placeholder-aprende-muted focus:outline-none focus:ring-2 focus:ring-aprende-primary transition-all">
      </div>
      <button type="submit" class="bg-aprende-primary hover:bg-[#159b3f] text-white w-full md:w-auto px-8 py-3.5 rounded-xl font-medium shadow-sm transition-transform hover:scale-[1.02] cursor-pointer whitespace-nowrap">
        buscar
      </button>
    </form>
  </div>

  <!-- Role Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Student Card -->
    <div class="bg-white border border-aprende-secondary rounded-[1.5rem] p-6 md:p-8 shadow-sm flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <div class="w-10 h-10 bg-aprende-bg rounded-full flex items-center justify-center mb-2">
          <svg class="w-5 h-5 text-aprende-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
            <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
          </svg>
        </div>
        <h2 class="text-xl font-medium text-aprende-text">Sou aluno</h2>
        <p class="text-aprende-muted">Encontre professores verificados por área</p>
      </div>
      <div class="mt-auto pt-2">
        <%= link_to "começar →", new_user_path(role: 'student'), class: "text-aprende-primary font-medium hover:underline inline-flex items-center" %>
      </div>
    </div>

    <!-- Teacher Card -->
    <div class="bg-white border border-aprende-secondary rounded-[1.5rem] p-6 md:p-8 shadow-sm flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <div class="w-10 h-10 bg-aprende-bg rounded-full flex items-center justify-center mb-2">
          <svg class="w-5 h-5 text-aprende-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h2 class="text-xl font-medium text-aprende-text">Sou professor</h2>
        <p class="text-aprende-muted">cadastre seu certificado e alcance alunos</p>
      </div>
      <div class="mt-auto pt-2">
        <%= link_to "cadastrar →", new_user_path(role: 'teacher'), class: "text-aprende-primary font-medium hover:underline inline-flex items-center" %>
      </div>
    </div>
  </div>

  <!-- Bottom Banner -->
  <div class="bg-aprende-secondary rounded-xl p-5 flex items-start md:items-center gap-3 border border-aprende-primary/20 flex-col md:flex-row">
    <div class="flex-shrink-0">
      <svg class="w-6 h-6 text-aprende-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
    <p class="text-aprende-text text-sm font-medium">professores com certificado técnico ou superior têm piso salarial garantido</p>
  </div>
</div>
