<div class="w-full max-w-md mx-auto mt-0 md:mt-4 bg-white p-6 md:p-8 rounded-[1.5rem] shadow-sm border border-aprende-secondary">
  <div class="text-center mb-6">
    <div class="h-12 w-12 bg-aprende-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
      <svg class="h-6 w-6 text-aprende-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
    </div>
    <h1 class="text-2xl font-medium text-aprende-text">Atualização de Termos</h1>
    <p class="mt-2 text-sm text-aprende-muted">
      Para continuar utilizando a plataforma aprendeAI, precisamos que leia e concorde com os novos documentos.
    </p>
  </div>

  <%= form_with url: submit_accept_terms_path, local: true, class: "space-y-6" do |f| %>
    <div class="bg-aprende-bg p-4 rounded-xl border border-aprende-secondary/40 text-sm text-aprende-text leading-relaxed">
      Acesse os documentos atualizados em nova aba:
      <ul class="list-disc pl-5 mt-2 space-y-1">
        <li>
          <%= link_to "Termos de Uso (Versão #{User::CURRENT_TERMS_VERSION})", terms_path, target: "_blank", class: "text-aprende-primary hover:underline font-medium focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-aprende-primary" %>
        </li>
        <li>
          <%= link_to "Política de Privacidade / LGPD (Versão #{User::CURRENT_PRIVACY_VERSION})", privacy_path, target: "_blank", class: "text-aprende-primary hover:underline font-medium focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-aprende-primary" %>
        </li>
      </ul>
    </div>

    <div class="flex items-start">
      <div class="flex items-center h-5">
        <%= f.check_box :terms_acceptance, { class: "h-5 w-5 text-aprende-primary focus:ring-aprende-primary border-aprende-secondary rounded bg-white cursor-pointer focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-aprende-primary" }, "1", "0" %>
      </div>
      <div class="ml-3 text-sm">
        <%= f.label :terms_acceptance, class: "text-aprende-text font-medium cursor-pointer" do %>
          Li e concordo expressamente com os novos Termos de Uso e Política de Privacidade do aprendeAI.
        <% end %>
      </div>
    </div>

    <div>
      <%= f.submit "Concordar e Continuar", class: "w-full bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 px-4 rounded-xl transition-colors cursor-pointer focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-aprende-primary" %>
    </div>
  <% end %>

  <div class="mt-6 pt-4 border-t border-aprende-secondary/40 text-center text-xs text-aprende-muted">
    Caso não concorde, você pode optar por
    <%= link_to "Sair da conta", logout_path, data: { turbo_method: :delete }, class: "text-aprende-muted hover:text-red-600 hover:underline font-medium focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-aprende-primary" %>
    a qualquer momento.
  </div>
</div>
