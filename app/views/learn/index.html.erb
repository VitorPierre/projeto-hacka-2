<% 
  is_teacher = current_user&.teacher?
  title = is_teacher ? "Planejar com IA" : "Aprender com IA"
  subtitle = is_teacher ? "Prepare suas aulas com o auxílio da nossa inteligência artificial." : "Tire suas dúvidas instantaneamente com nossa inteligência artificial."
  label = is_teacher ? "O que você vai ensinar hoje?" : "Qual sua dúvida hoje?"
  placeholder = is_teacher ? "Ex: Como explicar frações para o 5º ano?" : "Ex: O que é fotossíntese?"
  integration_text = is_teacher ? "Conectado ao seu perfil de professor." : "Conectado ao seu perfil de aluno."
  path = is_teacher ? plan_path : learn_path
%>

<div class="max-w-4xl mx-auto w-full flex flex-col gap-8">
  <div class="text-center">
    <h2 class="text-3xl md:text-4xl font-medium text-aprende-text"><%= is_teacher ? "Planejar" : "Aprender" %> com <span class="text-aprende-primary font-bold">AI</span></h2>
    <p class="text-aprende-muted mt-3 text-lg"><%= subtitle %></p>
  </div>

  <div class="bg-white rounded-[1.5rem] shadow-sm border border-aprende-secondary p-6 md:p-10 flex flex-col gap-6">
    <%= form_with url: path, method: :get, local: true, class: "flex flex-col gap-4" do |f| %>
      <div class="flex flex-col gap-2">
        <%= f.label :question, label, class: "text-sm font-medium text-aprende-text ml-1" %>
        <div class="relative">
          <%= f.text_field :question, value: @question, placeholder: placeholder, class: "w-full border-2 border-aprende-secondary rounded-2xl py-4 px-6 focus:outline-none focus:ring-2 focus:ring-aprende-primary bg-slate-50 text-aprende-text text-lg transition-all pr-16" %>
          <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 bg-aprende-primary hover:bg-[#159b3f] text-white p-2.5 rounded-xl transition-colors shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>
        <p class="text-xs text-aprende-muted mt-1 ml-1 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Sempre verifique as respostas geradas, pois a IA pode cometer erros.
        </p>
      </div>
    <% end %>

    <% if @answer.present? %>
      <div class="mt-4 pt-8 border-t border-aprende-secondary animate-in fade-in slide-in-from-top-4 duration-500">
        <h3 class="text-sm font-medium text-aprende-muted uppercase tracking-wider mb-4">Resposta da AI</h3>
        <div class="bg-aprende-bg border border-aprende-secondary rounded-[1.2rem] p-6 text-aprende-text leading-relaxed text-lg relative">
          <div class="absolute -top-3 left-6 bg-white px-2 text-aprende-primary">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z"></path>
              <path d="M12 2.252A8.001 8.001 0 0117.748 8H12V2.252z"></path>
            </svg>
          </div>
          <%= format_ai_response(@answer) %>
        </div>
        
        <% if !is_teacher %>
          <div class="mt-8 flex justify-center">
            <%= link_to teachers_path, class: "inline-flex items-center gap-2 text-aprende-primary hover:text-[#159b3f] font-medium transition-colors" do %>
              <span>Ainda com dúvida? Fale com um professor especializado</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
    <div class="bg-white/60 p-4 rounded-2xl border border-aprende-secondary text-center">
      <p class="text-xs font-bold text-aprende-primary uppercase mb-1">Rápido</p>
      <p class="text-sm text-aprende-muted">Respostas instantâneas para <%= is_teacher ? "seu planejamento" : "dúvidas básicas" %>.</p>
    </div>
    <div class="bg-white/60 p-4 rounded-2xl border border-aprende-secondary text-center">
      <p class="text-xs font-bold text-aprende-primary uppercase mb-1">Disponível</p>
      <p class="text-sm text-aprende-muted">Acesso 24/7 de qualquer lugar.</p>
    </div>
    <div class="bg-white/60 p-4 rounded-2xl border border-aprende-secondary text-center">
      <p class="text-xs font-bold text-aprende-primary uppercase mb-1">Integrado</p>
      <p class="text-sm text-aprende-muted"><%= integration_text %></p>
    </div>
  </div>
</div>
