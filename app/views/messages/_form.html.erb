<%= form_with model: [proposal, message], id: "new_message", class: "flex flex-col gap-3", multipart: true do |f| %>
  <% if current_user.teacher? %>
    <%= f.hidden_field :message_type, value: "regular", id: "message_type_field" %>
    
    <div class="flex border-b border-aprende-secondary mb-3 gap-2" role="tablist" aria-label="Tipo de mensagem">
      <button type="button" id="tab-message" onclick="switchTab('message')" role="tab" aria-selected="true" aria-controls="message_content_area" class="px-4 py-2 text-sm font-medium border-b-2 border-aprende-primary text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary rounded-t-lg transition-all cursor-pointer">
        Mensagem Normal
      </button>
      <button type="button" id="tab-activity" onclick="switchTab('activity')" role="tab" aria-selected="false" aria-controls="activity-controls" class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-aprende-muted hover:text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary rounded-t-lg transition-all cursor-pointer">
        Nova Atividade
      </button>
    </div>

    <div id="activity-controls" class="hidden flex flex-col gap-3 mb-2 p-4 bg-aprende-bg rounded-xl border border-aprende-secondary">
      <div class="flex flex-col gap-1.5">
        <label for="question_type_select" class="text-xs font-medium text-aprende-text">Tipo de Atividade</label>
        <%= f.select :question_type, [["Pergunta Aberta (resposta textual)", "open"], ["Pergunta Fechada (múltipla escolha)", "closed"]], {}, id: "question_type_select", onchange: "toggleQuestionType(this.value)", class: "w-full p-2.5 text-sm rounded-lg border border-aprende-secondary bg-white text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary cursor-pointer" %>
      </div>

      <div id="options-container" class="hidden flex flex-col gap-1.5">
        <label for="options_field" class="text-xs font-medium text-aprende-text">Opções de Seleção (uma por linha)</label>
        <%= f.text_area :options, id: "options_field", placeholder: "Opção A\nOpção B\nOpção C", rows: 3, class: "w-full p-2.5 text-sm rounded-lg border border-aprende-secondary bg-white text-aprende-text focus:outline-none focus:ring-2 focus:ring-aprende-primary resize-none" %>
      </div>
    </div>
  <% end %>

  <div class="relative">
    <%= f.text_area :content, id: "message_content_area", placeholder: "Escreva sua mensagem...", rows: 3, class: "w-full p-4 pb-12 rounded-xl border border-aprende-secondary bg-aprende-bg text-aprende-text placeholder-aprende-muted focus:outline-none focus:ring-2 focus:ring-aprende-primary transition-all resize-none", aria: { label: "Conteúdo da mensagem ou atividade" } %>
    
    <% if proposal.paid? || proposal.knowledge_pill? %>
      <div id="attachment-btn-container" class="absolute left-3 bottom-3 flex items-center gap-2">
        <label class="cursor-pointer text-aprende-muted hover:text-aprende-primary p-1.5 rounded-lg transition-colors" title="Anexar Arquivo">
          <%= f.file_field :attachment, class: "hidden", onchange: "this.form.requestSubmit();", aria: { label: "Anexar arquivo" } %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
        </label>
        <% if proposal.started_at? && !proposal.finished_at? && proposal.synchronous? %>
          <%= link_to "https://meet.jit.si/aprendeai-proposal-#{proposal.id}", target: "_blank", class: "text-[#0056b3] hover:text-[#004494] p-1.5 rounded-lg transition-colors", title: "Iniciar Videochamada Externa" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="absolute left-3 bottom-3 flex items-center gap-2 opacity-40 cursor-not-allowed" title="Anexos e Videochamada são liberados após a confirmação do pagamento.">
        <div class="text-aprende-muted p-1.5 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
        </div>
        <div class="text-aprende-muted p-1.5 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex justify-end">
    <%= f.submit "Enviar Mensagem", id: "submit-btn", class: "bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-2.5 px-6 rounded-xl transition-colors cursor-pointer shadow-sm" %>
  </div>
<% end %>

<% if current_user.teacher? %>
  <script>
    if (typeof switchTab === 'undefined') {
      window.switchTab = function(type) {
        const tabMsg = document.getElementById('tab-message');
        const tabAct = document.getElementById('tab-activity');
        const messageTypeField = document.getElementById('message_type_field');
        const activityControls = document.getElementById('activity-controls');
        const contentArea = document.getElementById('message_content_area');
        const attachmentBtn = document.getElementById('attachment-btn-container');
        const submitBtn = document.getElementById('submit-btn');

        if (type === 'activity') {
          tabAct.classList.add('border-aprende-primary', 'text-aprende-text');
          tabAct.classList.remove('border-transparent', 'text-aprende-muted');
          tabAct.setAttribute('aria-selected', 'true');
          
          tabMsg.classList.remove('border-aprende-primary', 'text-aprende-text');
          tabMsg.classList.add('border-transparent', 'text-aprende-muted');
          tabMsg.setAttribute('aria-selected', 'false');

          messageTypeField.value = 'activity';
          activityControls.classList.remove('hidden');
          contentArea.placeholder = 'Digite a pergunta ou enunciado da atividade...';
          if (attachmentBtn) attachmentBtn.classList.add('hidden');
          submitBtn.value = 'Enviar Atividade';
        } else {
          tabMsg.classList.add('border-aprende-primary', 'text-aprende-text');
          tabMsg.classList.remove('border-transparent', 'text-aprende-muted');
          tabMsg.setAttribute('aria-selected', 'true');
          
          tabAct.classList.remove('border-aprende-primary', 'text-aprende-text');
          tabAct.classList.add('border-transparent', 'text-aprende-muted');
          tabAct.setAttribute('aria-selected', 'false');

          messageTypeField.value = 'regular';
          activityControls.classList.add('hidden');
          contentArea.placeholder = 'Escreva sua mensagem...';
          if (attachmentBtn) attachmentBtn.classList.remove('hidden');
          submitBtn.value = 'Enviar Mensagem';
        }
      }
    }

    if (typeof toggleQuestionType === 'undefined') {
      window.toggleQuestionType = function(val) {
        const optionsContainer = document.getElementById('options-container');
        const optionsField = document.getElementById('options_field');
        if (val === 'closed') {
          optionsContainer.classList.remove('hidden');
          optionsField.setAttribute('required', 'required');
        } else {
          optionsContainer.classList.add('hidden');
          optionsField.removeAttribute('required');
        }
      }
    }
  </script>
<% end %>
