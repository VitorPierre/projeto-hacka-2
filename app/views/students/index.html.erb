<div class="mb-6 md:mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl md:text-3xl font-medium text-aprende-text">Alunos Disponíveis</h1>
    <p class="text-aprende-muted mt-2">Conheça os alunos que buscam aprendizado na plataforma.</p>
  </div>
  <%= render 'subjects/manager', url: students_path, blank_label: "Todas as Áreas" %>
</div>

<% if @students.any? %>
  <section aria-label="Alunos listados" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
    <% @students.each do |student| %>
      <div class="bg-white rounded-[1.5rem] shadow-sm border border-aprende-secondary p-6 md:p-8 flex flex-col h-full gap-4">
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <%= user_avatar(student, size: "w-14 h-14", text_size: "text-xl") %>
            <div>
              <h2 class="text-xl font-medium text-aprende-text flex items-center gap-2">
                <%= student.name %>
                <% if student.pcd? %>
                  <span class="bg-[#e8f6ed] text-[#0f6b2e] text-[10px] px-2 py-0.5 rounded-full font-semibold border border-[#c2e8cf]" title="Pessoa com Deficiência">PcD</span>
                <% end %>
              </h2>
            </div>
          </div>
          
          <% if student.subjects.any? %>
            <div class="mt-4">
              <p class="text-sm text-aprende-muted mb-3 font-medium">Áreas de Interesse</p>
              <div class="flex flex-wrap gap-2">
                <% student.subjects.each do |subject| %>
                  <span class="bg-aprende-bg border border-aprende-secondary text-aprende-text text-xs px-3 py-1.5 rounded-full font-medium"><%= subject.name %></span>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="mt-4">
            <p class="text-sm text-aprende-muted mb-2 font-medium">Preferências e Objetivos</p>
            <p class="text-aprende-text text-xs leading-relaxed italic line-clamp-3">
              <%= user_preferences_display(student, truncated: true) %>
            </p>
          </div>

          <div class="mt-4">
            <p class="text-sm text-aprende-muted mb-2 font-medium">Disponibilidade</p>
            <p class="text-aprende-text text-xs leading-relaxed italic">
              <%= student.availability.present? ? student.availability : "Horário a combinar." %>
            </p>
          </div>
        </div>

        <div class="mt-auto pt-6 border-t border-aprende-secondary flex flex-col gap-3">
          <% if !current_user %>
            <%= link_to "Entrar para Ver Perfil", login_path, class: "block w-full text-center bg-aprende-primary hover:bg-[#159b3f] text-white font-medium py-3 rounded-xl transition-colors" %>
          <% else %>
            <%= link_to "Ver Perfil", student_path(student), class: "block w-full text-center bg-white border border-aprende-secondary hover:bg-aprende-bg text-aprende-text font-medium py-3 rounded-xl transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% else %>
  <div class="bg-white border border-aprende-secondary rounded-[1.5rem] p-12 text-center shadow-sm flex flex-col items-center justify-center gap-4">
    <div class="w-16 h-16 bg-slate-50 border border-slate-100 rounded-full flex items-center justify-center text-aprende-primary">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
    </div>
    <h2 class="text-xl font-bold text-aprende-text">Nenhum estudante encontrado</h2>
    <p class="text-aprende-muted max-w-md text-sm leading-relaxed"><%= params[:subject_id].present? ? "Não encontramos nenhum estudante interessado na área selecionada no momento." : "Atualmente não há estudantes cadastrados nesta listagem." %></p>
    <% if params[:subject_id].present? %>
      <%= link_to "Limpar Filtro de Especialidades", students_path, class: "mt-2 bg-aprende-primary hover:bg-[#159b3f] text-white font-medium px-6 py-2.5 rounded-xl text-sm transition-all hover:scale-[1.02] shadow-sm cursor-pointer" %>
    <% end %>
  </div>
<% end %>
